#!/usr/bin/env bash
# Routine status write-back: one JSON line per routine run.
#
# Modeled on google/ax's task phase + conditions. A routine's platform status
# ("SUCCEEDED") only means its session ended, so each routine records what it
# actually did. Records live on their own branch, so writing one needs no PR
# and never touches main. Contract: .claude/automation/CONTRACT.md
#
# Usage:
#   bin/routine-status record <routine> <phase> <reason> [--started <iso8601>]
#                             [--pr <n>] [--issues <n,n,...>] [--max-age-hours <n>]
#   bin/routine-status show [--max-age-hours <n>] [--check]
#   bin/routine-status state get <routine> <file>
#   bin/routine-status state put <routine> <file> < content
#
# Phases: Succeeded | Failed | TimedOut | Blocked
#   Blocked = preflight failed (no repo, no GitHub access, ...); nothing was done.
#
# `show` prints the latest record per routine. Rows that are not Succeeded, or
# overdue, are marked with "!". A routine is overdue when its latest record is
# older than the --max-age-hours it recorded (its own cadence, e.g. 26 for a
# daily routine, 170 for a weekly one), else the default from `show
# --max-age-hours` (26). With --check it exits 1 if any row is marked, and it
# exits 2 if the status branch can't be read.
#
# `state` keeps a routine's working files (coverage matrix, bug backlog, ...)
# at state/<routine>/<file> on the same branch, so each run starts from the
# last run's state, not from a stale copy on main. `get` prints the file; it
# exits 1 if there is no such state yet (a first run) and 2 if the branch
# can't be read. `put` replaces the file with stdin. It refuses empty input,
# so a broken pipe can't wipe state, and an unchanged file makes no commit.
# No command follows a symlink on the branch (see no_symlinks).
#
# Environment:
#   CARO_STATUS_REMOTE  git remote name or URL (default: origin)
#   CARO_STATUS_BRANCH  status branch (default: automation/routine-status)
#   CARO_STATUS_ATTEMPTS  push attempts before giving up (default: 10)

set -euo pipefail

REMOTE="${CARO_STATUS_REMOTE:-origin}"
BRANCH="${CARO_STATUS_BRANCH:-automation/routine-status}"
FILE="runs.jsonl"

WORK=""
trap '[[ -n "$WORK" ]] && rm -rf "$WORK"' EXIT

die() { echo "routine-status: $*" >&2; exit 2; }

case "$BRANCH" in
  main | master | "") die "refusing to write status to branch '$BRANCH'" ;;
esac

remote_url() {
  git remote get-url "$REMOTE" 2>/dev/null || printf '%s\n' "$REMOTE"
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# A state path part is one plain path component: no slash, no leading dot.
valid_part() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

# Any agent can push to the status branch, and a symlink planted there would
# make a read print, or a write overwrite, a file outside the clone. So no
# part of <path> under <tree> may be a symlink, and an existing target must
# be a regular file.
no_symlinks() { # <tree> <path>
  local p="$1" part
  local -a parts
  IFS=/ read -r -a parts <<<"$2"
  for part in "${parts[@]}"; do
    p="$p/$part"
    if [[ -L "$p" ]]; then
      die "refusing to follow a symlink at ${p#"$1"/} on $BRANCH"
    fi
  done
  [[ ! -e "$p" || -f "$p" ]] || die "refusing ${p#"$1"/} on $BRANCH: not a regular file"
}

# Clone the status branch into "$WORK/wt". Returns 1 when the branch does not
# exist yet. Only a confirmed-missing branch means "nothing yet": an
# unreachable remote or expired auth is an error, not an empty history.
clone_branch() {
  local url rc=0 err
  url="$(remote_url)"
  err="$(git ls-remote --exit-code --heads "$url" "$BRANCH" 2>&1 >/dev/null)" || rc=$?
  if [[ $rc -eq 2 ]]; then
    return 1
  elif [[ $rc -ne 0 ]]; then
    die "cannot read status branch from $url: ${err:-git ls-remote exit $rc}"
  fi
  [[ -n "$WORK" ]] || WORK="$(mktemp -d)"
  err="$(git clone -q --depth 1 --single-branch --branch "$BRANCH" "$url" "$WORK/wt" 2>&1)" ||
    die "cannot read status branch from $url: $err"
}

# Commit one change to the status branch: clone it fresh (or start it), run
# the edit command with the tree's path as its last argument, and push.
# Concurrent writers: a rejected push re-clones and re-applies the edit. The
# backoff is randomized so simultaneous writers don't keep colliding in
# lockstep. An edit that changes nothing commits nothing.
commit_change() {
  local msg="$1"
  shift
  local url tree attempt err="" attempts="${CARO_STATUS_ATTEMPTS:-10}"
  url="$(remote_url)"
  [[ -n "$WORK" ]] || WORK="$(mktemp -d)"
  tree="$WORK/wt"
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    rm -rf "$tree"
    if ! git clone -q --depth 1 --single-branch --branch "$BRANCH" "$url" "$tree" 2>/dev/null; then
      git init -q "$tree"
      git -C "$tree" checkout -q --orphan "$BRANCH"
      git -C "$tree" remote add origin "$url"
    fi
    "$@" "$tree"
    git -C "$tree" add -A
    git -C "$tree" diff --cached --quiet && return 0
    git -C "$tree" config user.email >/dev/null || git -C "$tree" config user.email "routine@caro.invalid"
    git -C "$tree" config user.name >/dev/null || git -C "$tree" config user.name "caro routine"
    git -C "$tree" commit -q -m "$msg"
    if err="$(git -C "$tree" push -q origin "HEAD:refs/heads/$BRANCH" 2>&1)"; then
      return 0
    fi
    sleep "$((RANDOM % (attempt + 1))).$((RANDOM % 10))"
  done
  die "could not push to $BRANCH after $attempts attempts. Last error: ${err:-none}"
}

append_line() { # <line> <tree>
  no_symlinks "$2" "$FILE"
  printf '%s\n' "$1" >>"$2/$FILE"
}
write_file() { # <src> <path> <tree>
  no_symlinks "$3" "$2"
  mkdir -p "$(dirname "$3/$2")" && cp "$1" "$3/$2"
}

record() {
  [[ $# -ge 3 ]] || die "usage: record <routine> <phase> <reason> [--started ts] [--pr n] [--issues n,n] [--max-age-hours n]"
  local routine="$1" phase="$2" reason="$3" started="" pr="" issues="" max_age=""
  shift 3
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --started) started="${2:-}"; shift 2 ;;
      --pr) pr="${2:-}"; shift 2 ;;
      --issues) issues="${2:-}"; shift 2 ;;
      --max-age-hours) max_age="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  case "$phase" in
    Succeeded | Failed | TimedOut | Blocked) ;;
    *) die "phase must be Succeeded, Failed, TimedOut or Blocked (got '$phase')" ;;
  esac
  [[ -n "$routine" && -n "$reason" ]] || die "routine and reason must be non-empty"
  [[ -z "$pr" || "$pr" =~ ^[0-9]+$ ]] || die "--pr must be a number"
  [[ -z "$issues" || "$issues" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "--issues must be n,n,..."
  [[ -z "$max_age" || "$max_age" =~ ^[1-9][0-9]*$ ]] || die "--max-age-hours must be a positive number"

  local line
  line="$(python3 - "$routine" "$phase" "$reason" "${started:-$(now)}" "$(now)" "$pr" "$issues" "$max_age" <<'PY'
import json, sys
routine, phase, reason, started, finished, pr, issues, max_age = sys.argv[1:]
rec = {
    "routine": routine, "phase": phase, "reason": reason,
    "started": started, "finished": finished,
    "pr": int(pr) if pr else None,
    "issues": [int(i) for i in issues.split(",")] if issues else [],
}
if max_age:
    rec["max_age_hours"] = int(max_age)
print(json.dumps(rec, separators=(",", ":")))
PY
)"

  commit_change "status: $routine $phase" append_line "$line"
  printf '%s\n' "$line"
}

show() {
  local max_age=26 check=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-age-hours) max_age="${2:-}"; shift 2 ;;
      --check) check=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ "$max_age" =~ ^[0-9]+$ ]] || die "--max-age-hours must be a number"

  if ! clone_branch; then
    echo "no status records yet (branch $BRANCH not found)"
    return $((check))
  fi
  no_symlinks "$WORK/wt" "$FILE"
  # `state put` can create the branch before any run records one.
  if [[ ! -f "$WORK/wt/$FILE" ]]; then
    echo "no status records yet ($BRANCH has no $FILE)"
    return $((check))
  fi
  python3 - "$WORK/wt/$FILE" "$max_age" "$check" <<'PY'
import json, sys
from datetime import datetime, timezone

path, max_age, check = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
latest = {}
with open(path) as f:
    for raw in f:
        raw = raw.strip()
        if not raw:
            continue
        rec = json.loads(raw)
        latest[rec["routine"]] = rec  # append-only, so the last line wins

now = datetime.now(timezone.utc)
flagged = 0
print(f"{'':1} {'routine':32} {'phase':10} {'age':>6}  reason")
for name in sorted(latest):
    rec = latest[name]
    finished = datetime.fromisoformat(rec["finished"].replace("Z", "+00:00"))
    hours = (now - finished).total_seconds() / 3600
    bad = rec["phase"] != "Succeeded" or hours > rec.get("max_age_hours", max_age)
    flagged += bad
    extra = f" (PR #{rec['pr']})" if rec.get("pr") else ""
    print(f"{'!' if bad else ' ':1} {name:32} {rec['phase']:10} {hours:5.1f}h  {rec['reason']}{extra}")
sys.exit(1 if check and flagged else 0)
PY
}

state_cmd() {
  [[ $# -eq 3 && ("$1" == get || "$1" == put) ]] ||
    die "usage: state get <routine> <file> | state put <routine> <file> < content"
  local sub="$1" routine="$2" name="$3"
  valid_part "$routine" || die "invalid routine name '$routine' (one path component: letters, digits, . _ -)"
  valid_part "$name" || die "invalid state file name '$name' (one path component: letters, digits, . _ -)"
  local path="state/$routine/$name"
  if [[ "$sub" == get ]]; then
    if clone_branch; then
      no_symlinks "$WORK/wt" "$path"
      if [[ -f "$WORK/wt/$path" ]]; then
        cat "$WORK/wt/$path"
        return 0
      fi
    fi
    echo "routine-status: no state yet at $path" >&2
    return 1
  else
    WORK="$(mktemp -d)"
    cat >"$WORK/input"
    [[ -s "$WORK/input" ]] || die "refusing to write empty state to $path (a broken pipe must not wipe it)"
    commit_change "state: $path" write_file "$WORK/input" "$path"
    echo "saved $path"
  fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
  record) record "$@" ;;
  show) show "$@" ;;
  state) state_cmd "$@" ;;
  *) die "usage: $0 record|show|state ... (see header)" ;;
esac
