# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.local for Caro workspace config)
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user data (created at runtime)
data/.agents/.config/
data/.agents/.history/
data/.agents/.memory/
data/.agents/.messages/
data/.agents/.slack/
data/.agents/.config.json
# NOTE: Agent persona directories are NOT ignored — they are committed to the repo
# as part of the Caro AI company configuration
!data/.agents/.library/
data/.chat/
data/.missions/
data/.playbooks/
data/.cabinet.db
data/.cabinet.db-shm
data/.cabinet.db-wal

# claude code
.claude/

# stray build artifacts
data/.agents/.library/.next/
