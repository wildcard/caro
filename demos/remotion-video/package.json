{
  "name": "caro-remotion-video",
  "private": true,
  "version": "1.0.0",
  "description": "Caro landing-page demo video, rendered from React via Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render CaroDemo ../../website/public/caro-demo.mp4 --codec=h264 --crf=23 --image-format=jpeg",
    "poster": "remotion still CaroDemo ../../website/public/caro-demo-poster.png --frame=60",
    "ship": "npm run build && npm run poster"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.462",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
