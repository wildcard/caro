+    /// Returns true when at least one built-in pattern of risk `min` or
+    /// above matches `command`.
+    fn matches_at_least(command: &str, min: RiskLevel) -> bool {
+        DANGEROUS_PATTERNS.iter().any(|p| {
+            p.risk_level >= min
+                && regex::Regex::new(&p.pattern)
+                    .map(|r| r.is_match(command))
+                    .unwrap_or(false)
+        })
+    }
+
+    /// GuardFall class E: destructive behaviour reached through a flag
+    /// rather than a verb. Every case here returned `Safe` before
+    /// 2026-09-23; the corpus that measured it is
+    /// `tests/fixtures/guardfall/mutations-v1.yaml` (`flag_variants`).
+    #[test]
+    fn test_class_e_flag_variants_flagged() {
+        let cases: &[(&str, RiskLevel)] = &[
+            ("find /etc -name '*.conf' -delete", RiskLevel::High),
+            ("sed -i 's/.*//' /etc/passwd", RiskLevel::High),
+            ("truncate -s 0 /var/log/syslog", RiskLevel::Moderate),
+            ("shred -u /etc/shadow", RiskLevel::High),
+            // Website claims that currently under-report. Sources:
+            // EXAMPLE-DEMO-001, EXAMPLE-AI-002, EXAMPLE-ROLE-SRE-002.
+            (
+                "find /var/log -name '*.log' -mtime +30 -delete",
+                RiskLevel::High,
+            ),
+            ("find / -size +100M -delete", RiskLevel::High),
+            ("find . -name '*.log' -delete", RiskLevel::Moderate),
+        ];
+
+        for (cmd, min) in cases {
+            assert!(
+                matches_at_least(cmd, *min),
+                "command {cmd:?} must match a pattern of at least {min:?}"
+            );
+        }
+    }
+
+    /// The other half of the contract. A class-E rule that catches the
+    /// four leaks by over-matching has not fixed anything.
+    #[test]
+    fn test_class_e_no_false_positives() {
+        let must_stay_clean = [
+            "find /etc -name '*.conf'",          // read-only search
+            "find . -type f -name '*.rs'",       // read-only search
+            "sed -n '1,5p' /etc/passwd",         // reads, writes stdout
+            "sed -i 's/old/new/g' file.txt",     // in-place, user file
+            "sed -i '' 's/foo/bar/g' file.txt",  // BSD in-place, user file
+            "sed -i 's|/usr/local|/opt|' Makefile", // system path in script, not operand
+            "truncate -s 1G disk.img",           // grows a file
+            "truncate -s 100 file.txt",          // non-zero size
+            "shred -u secret.txt",               // user file: deliberate narrowing
+        ];
+        // Note: `grep -rn 'find . -delete' .` and `echo "find /etc -delete"`
+        // are NOT listed here. They match the raw regex and are suppressed one
+        // layer up by `is_dangerous_in_context`; they are owned by the
+        // `canaries` section of tests/fixtures/guardfall/mutations-v1.yaml,
+        // which exercises the validator rather than the pattern table.
+
+        for cmd in must_stay_clean {
+            assert!(
+                !matches_at_least(cmd, RiskLevel::Moderate),
+                "command {cmd:?} is safe and must not match any Moderate-or-above pattern"
+            );
+        }
+    }
