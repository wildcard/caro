# =============================================================================
# Upstash Redis (provisioned via Vercel Marketplace → Storage → Upstash Redis)
# =============================================================================
# Vercel auto-injects these at build/runtime once the integration is connected
# to the project. Local development: run `vercel env pull website/.env.local`
# from the project root to populate them. The @upstash/redis client's
# Redis.fromEnv() reads UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy aliases (older integration versions). Either set is sufficient.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# =============================================================================
# Vercel BotID
# =============================================================================
# No env vars needed. Enable in Vercel dashboard:
#   1. Project → Settings → BotID → Enable
#   2. Project → Firewall → Rules → enable "Vercel BotID Deep Analysis" (Recommended)
# Local dev always returns isBot:false unless `developmentOptions` is set on
# checkBotId() — verify BotID end-to-end on a Vercel preview deploy, not local.
