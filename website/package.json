{
  "name": "caro-website",
  "type": "module",
  "version": "1.0.0",
  "description": "Official website for Caro - Your loyal shell companion",
  "scripts": {
    "generate-search-index": "node scripts/generate-search-index.mjs",
    "prebuild": "node scripts/extract-version.mjs && node scripts/generate-search-index.mjs",
    "predev": "node scripts/extract-version.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/db": "^0.14.1",
    "@astrojs/react": "^4.4.2",
    "@astrojs/vercel": "^11.0.3",
    "@vercel/analytics": "^1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.2.8",
    "canvas-confetti": "^1.9.4",
    "codex-pet-companion": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/azeret-mono": "^5.3.0",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/theming": "^8.6.15",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.16",
    "opentype.js": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "storybook": "^8.6.15",
    "unified": "^11.0.5",
    "vite": "^6.4.2",
    "vitest": "^5.0.4"
  }
