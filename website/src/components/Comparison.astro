---
import { t, type Locale } from '../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

// Comparison table data structured for growth-hacking SEO and conversion.
// The competitor values changed in the 2026-10-11 refresh were checked against
// vendor docs; values not changed then were carried over unverified (see
// docs/research/2026-10-11-competitive-landscape-refresh.md section 6).
// 'partial' means opt-in, configurable or incomplete (e.g. user-written rules,
// a local model only through a public tunnel). 'unknown' means the vendor's
// docs do not say; never turn a missing source into 'no'.
// Criteria: existingTerminal = the product's AI is usable from the user's own
// terminal emulator; multiBackend = the user can choose among model providers
// or a custom endpoint (localInference covers local models).
const competitors = [
  { id: 'caro', nameKey: 'caro', highlight: true },
  { id: 'copilot-cli', nameKey: 'copilotCli' },
  { id: 'warp', nameKey: 'warp' },
  { id: 'kiro', nameKey: 'kiro' },
  { id: 'opencode', nameKey: 'opencode' },
];

type FeatureValue = 'yes' | 'no' | 'partial' | 'unknown' | string;

interface ComparisonRow {
  featureKey: string;
  values: Record<string, FeatureValue>;
}

// Category icons are terminal glyphs: a 24 px table heading is too small for
// a Kyaro sprite (docs/brand/ICONOGRAPHY.md). Emoji are not icons.
// ▸ privacy, ■ safety, >_ shell, ❯ model.

// Category and feature keys for translation lookup
const comparisonData: { categoryKey: string; icon: string; rows: ComparisonRow[] }[] = [
  {
    categoryKey: 'privacyData',
    icon: '▸',
    rows: [
      { featureKey: 'worksOffline', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'no', 'kiro': 'no', 'opencode': 'partial' } },
      { featureKey: 'privacyFirst', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'no', 'kiro': 'no', 'opencode': 'yes' } },
      { featureKey: 'airGapped', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'no', 'kiro': 'no', 'opencode': 'partial' } },
      { featureKey: 'openSource', values: { 'caro': 'yes', 'copilot-cli': 'no', 'warp': 'partial', 'kiro': 'no', 'opencode': 'yes' } },
    ]
  },
  {
    categoryKey: 'safetyControl',
    icon: '■',
    rows: [
      { featureKey: 'ruleBasedSafety', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'partial', 'kiro': 'partial', 'opencode': 'partial' } },
      { featureKey: 'explicitConfirmation', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'partial', 'kiro': 'partial', 'opencode': 'no' } },
      // blocksDangerous 'no': each vendor documents its default as asking
      // (Copilot, Kiro, Warp) or allowing (OpenCode bash), not blocking.
      { featureKey: 'blocksDangerous', values: { 'caro': 'yes', 'copilot-cli': 'no', 'warp': 'no', 'kiro': 'no', 'opencode': 'no' } },
      { featureKey: 'riskLevel', values: { 'caro': 'yes', 'copilot-cli': 'unknown', 'warp': 'unknown', 'kiro': 'unknown', 'opencode': 'unknown' } },
    ]
  },
  {
    categoryKey: 'shellExpertise',
    icon: '>_',
    rows: [
      { featureKey: 'posixFirst', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'partial', 'kiro': 'partial', 'opencode': 'partial' } },
      // The label says macOS/Linux/BSD. Neither Caro nor Warp ships a BSD build
      // (Caro release.yml: Linux, macOS, Windows). BSD support for Copilot CLI,
      // Kiro CLI and OpenCode has no primary source, so those cells are unknown.
      { featureKey: 'crossPlatform', values: { 'caro': 'partial', 'copilot-cli': 'unknown', 'warp': 'partial', 'kiro': 'unknown', 'opencode': 'unknown' } },
      { featureKey: 'existingTerminal', values: { 'caro': 'yes', 'copilot-cli': 'yes', 'warp': 'yes', 'kiro': 'yes', 'opencode': 'yes' } },
      { featureKey: 'platformAware', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'unknown', 'kiro': 'partial', 'opencode': 'partial' } },
    ]
  },
  {
    categoryKey: 'modelBackend',
    icon: '❯',
    rows: [
      { featureKey: 'localInference', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'partial', 'kiro': 'no', 'opencode': 'partial' } },
      { featureKey: 'multiBackend', values: { 'caro': 'yes', 'copilot-cli': 'yes', 'warp': 'yes', 'kiro': 'partial', 'opencode': 'yes' } },
      { featureKey: 'appleSilicon', values: { 'caro': 'partial', 'copilot-cli': 'no', 'warp': 'no', 'kiro': 'no', 'opencode': 'no' } },
      { featureKey: 'selfHostable', values: { 'caro': 'yes', 'copilot-cli': 'partial', 'warp': 'partial', 'kiro': 'no', 'opencode': 'yes' } },
    ]
  },
];

// Helper to render cell value - returns key for translation
function getCellDisplay(value: FeatureValue): { icon: string; class: string; labelKey: string; isCustom: boolean; customLabel?: string } {
  switch (value) {
    case 'yes':
      return { icon: '✓', class: 'cell-yes', labelKey: 'yes', isCustom: false };
    case 'no':
      return { icon: '✗', class: 'cell-no', labelKey: 'no', isCustom: false };
    case 'partial':
      return { icon: '◐', class: 'cell-partial', labelKey: 'partial', isCustom: false };
    case 'planned':
      return { icon: '◎', class: 'cell-planned', labelKey: 'planned', isCustom: false };
    case 'unknown':
      return { icon: '?', class: 'cell-unknown', labelKey: 'unknown', isCustom: false };
    default:
      return { icon: '', class: 'cell-text', labelKey: '', isCustom: true, customLabel: value };
  }
}

// Link helpers
const telemetryHref = lang === 'en' ? '/telemetry' : `/${lang}/telemetry`;
const downloadHref = lang === 'en' ? '#download' : `/${lang}/#download`;
const compareHref = lang === 'en' ? '/compare' : `/${lang}/compare`;
---

<section id="compare" class="comparison-section">
  <div class="container">
    <h2>{t(lang, 'landing.comparison.title')}</h2>
    <p class="section-subtitle">
      {t(lang, 'landing.comparison.subtitle')}
    </p>

    <!-- Quick Summary Cards -->
    <div class="summary-cards">
      <a href={telemetryHref} class="summary-card highlight summary-card-link">
        <span class="summary-icon term-glyph" aria-hidden="true">▸</span>
        <span class="summary-stat">{t(lang, 'landing.comparison.summary.privacy.stat')}</span>
        <span class="summary-label">{t(lang, 'landing.comparison.summary.privacy.label')}</span>
      </a>
      <div class="summary-card highlight">
        <span class="summary-icon term-glyph" aria-hidden="true">■</span>
        <span class="summary-stat">{t(lang, 'landing.comparison.summary.safety.stat')}</span>
        <span class="summary-label">{t(lang, 'landing.comparison.summary.safety.label')}</span>
      </div>
      <div class="summary-card highlight">
        <span class="summary-icon term-glyph" aria-hidden="true">$</span>
        <span class="summary-stat">{t(lang, 'landing.comparison.summary.offline.stat')}</span>
        <span class="summary-label">{t(lang, 'landing.comparison.summary.offline.label')}</span>
      </div>
      <div class="summary-card highlight">
        <span class="summary-icon term-glyph" aria-hidden="true">❯</span>
        <span class="summary-stat">{t(lang, 'landing.comparison.summary.speed.stat')}</span>
        <span class="summary-label">{t(lang, 'landing.comparison.summary.speed.label')}</span>
      </div>
    </div>

    <!-- Comparison Tables by Category -->
    {comparisonData.map((category) => (
      <div class="comparison-category">
        <h3 class="category-title">
          <span class="category-icon" aria-hidden="true">
            {category.icon}
          </span>
          {t(lang, `landing.comparison.categories.${category.categoryKey}.title`)}
        </h3>
        <div
          class="table-wrapper"
          tabindex="0"
          role="region"
          aria-label={t(lang, `landing.comparison.categories.${category.categoryKey}.title`)}
        >
          <table class="comparison-table">
            <thead>
              <tr>
                <th class="feature-header">{t(lang, 'landing.comparison.table.feature')}</th>
                {competitors.map((comp) => (
                  <th class={comp.highlight ? 'competitor-header highlight' : 'competitor-header'}>
                    {comp.highlight && <span class="highlight-badge">{t(lang, 'landing.comparison.table.youreHere')}</span>}
                    {t(lang, `landing.comparison.competitors.${comp.nameKey}`)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {category.rows.map((row) => {
                const featureName = t(lang, `landing.comparison.categories.${category.categoryKey}.features.${row.featureKey}.name`);
                const featureTooltip = t(lang, `landing.comparison.categories.${category.categoryKey}.features.${row.featureKey}.tooltip`);
                return (
                  <tr>
                    <td class="feature-cell" title={featureTooltip}>
                      {featureName}
                      {featureTooltip && <span class="tooltip-icon" role="img" aria-label={featureTooltip}>?</span>}
                    </td>
                    {competitors.map((comp) => {
                      const display = getCellDisplay(row.values[comp.id]);
                      const displayLabel = display.isCustom ? display.customLabel : t(lang, `landing.comparison.values.${display.labelKey}`);
                      return (
                        <td class={`value-cell ${display.class} ${comp.highlight ? 'highlight-col' : ''}`}>
                          {display.isCustom
                            ? <span class="cell-text-value">{displayLabel}</span>
                            : <span class="cell-icon" role="img" aria-label={displayLabel}>{display.icon}</span>}
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <!-- Bottom CTA -->
    <div class="comparison-cta">
      <p class="cta-text">{t(lang, 'landing.comparison.cta.text')}</p>
      <div class="cta-buttons">
        <a href={downloadHref} class="cta-button primary">{t(lang, 'landing.comparison.cta.getStarted')}</a>
        <a href={compareHref} class="cta-button secondary">{t(lang, 'landing.comparison.cta.fullComparison')}</a>
      </div>
    </div>

    <!-- Legend -->
    <div class="legend">
      <span class="legend-item"><span class="legend-icon cell-yes" aria-hidden="true">✓</span> {t(lang, 'landing.comparison.legend.fullSupport')}</span>
      <span class="legend-item"><span class="legend-icon cell-partial" aria-hidden="true">◐</span> {t(lang, 'landing.comparison.legend.partial')}</span>
      <span class="legend-item"><span class="legend-icon cell-no" aria-hidden="true">✗</span> {t(lang, 'landing.comparison.legend.notSupported')}</span>
      <span class="legend-item"><span class="legend-icon cell-planned" aria-hidden="true">◎</span> {t(lang, 'landing.comparison.legend.planned')}</span>
      <span class="legend-item"><span class="legend-icon cell-unknown" aria-hidden="true">?</span> {t(lang, 'landing.comparison.legend.notDocumented')}</span>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    background: var(--color-bg-secondary);
    padding: 80px 20px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    font-size: 36px;
    text-align: center;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 18px;
    margin-bottom: 40px;
  }

  /* Summary Cards */
  .summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px;
    margin-bottom: 50px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .summary-card {
    min-width: 0;
    overflow-wrap: anywhere;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .summary-card.highlight {
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(239, 51, 51, 0.1);
  }

  .summary-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(239, 51, 51, 0.15);
  }

  .summary-card-link {
    text-decoration: none;
    cursor: pointer;
  }

  .summary-card-link:hover .summary-stat {
    text-decoration: underline;
  }

  .summary-icon {
    display: flex;
    justify-content: center;
    font-size: 28px;
    line-height: 1;
    color: var(--accent);
  }

  .term-glyph {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .summary-stat {
    font-size: 24px;
    font-weight: 700;
    color: var(--accent-text);
  }

  .summary-label {
    font-size: 13px;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Category Headers */
  .comparison-category {
    margin-bottom: 40px;
  }

  .category-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .category-icon {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  /* Table Wrapper for horizontal scroll on mobile */
  .table-wrapper {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* Keyboard users scroll the table on narrow screens (focusable region). */
  .table-wrapper:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 700px;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 14px 16px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-table th {
    background: var(--color-bg-tertiary);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-text);
    position: relative;
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tbody tr:hover {
    background: var(--color-bg-tertiary);
  }

  .feature-header {
    text-align: start !important;
    min-width: 200px;
  }

  .competitor-header {
    min-width: 120px;
    white-space: nowrap;
  }

  .competitor-header.highlight {
    background: rgba(239, 51, 51, 0.15);
    color: var(--accent-text);
  }

  .highlight-badge {
    display: block;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent-text);
    margin-bottom: 4px;
  }

  .feature-cell {
    text-align: start !important;
    font-size: 14px;
    color: var(--color-text);
    position: relative;
  }

  .tooltip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-inline-start: 6px;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border-radius: 50%;
    cursor: help;
    vertical-align: middle;
  }

  .value-cell {
    font-size: 18px;
  }

  .highlight-col {
    background: rgba(239, 51, 51, 0.05);
  }

  .cell-icon {
    font-weight: 600;
  }

  /* Status glyphs meet 4.5:1 in both modes; the shape (✓ ◐ ✗ ◎) carries
     the meaning, colour only reinforces it. */
  .cell-yes .cell-icon,
  .legend-icon.cell-yes {
    color: var(--status-safe-text);
  }

  .cell-no .cell-icon,
  .legend-icon.cell-no {
    color: var(--accent-text);
  }

  .cell-partial .cell-icon,
  .legend-icon.cell-partial,
  .cell-unknown .cell-icon,
  .legend-icon.cell-unknown {
    color: var(--fg);
  }

  .cell-planned .cell-icon,
  .legend-icon.cell-planned {
    color: var(--fg-muted);
  }

  .cell-text-value {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* CTA Section */
  .comparison-cta {
    text-align: center;
    margin: 50px 0 30px;
    padding: 40px;
    background: rgba(239, 51, 51, 0.1);
    border-radius: 16px;
    border: 1px solid rgba(239, 51, 51, 0.2);
  }

  .cta-text {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cta-button.primary {
    background: var(--accent-fill);
    color: var(--on-accent);
    border: none;
  }

  .cta-button.primary:hover {
    background: var(--accent-fill-hover);
    color: var(--on-accent);
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(239, 51, 51, 0.3);
  }

  .cta-button.secondary {
    background: transparent;
    color: var(--accent-text);
    border: 2px solid var(--accent);
  }

  .cta-button.secondary:hover {
    color: var(--accent-text);
    background: rgba(239, 51, 51, 0.1);
  }

  .cta-button:focus-visible {
    outline: 3px solid var(--fg-strong);
    outline-offset: 3px;
  }

  /* Legend */
  .legend {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-icon {
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 768px) {
    h2 {
      font-size: 28px;
    }

    .summary-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .comparison-cta {
      padding: 30px 20px;
    }

    .cta-text {
      font-size: 18px;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-button {
      width: 100%;
      max-width: 280px;
    }
  }
</style>

<script>
  // A table region needs a tab stop only while it scrolls sideways (WCAG
  // 2.1.1). The markup ships tabindex="0" so it still works without script.
  const wrappers = document.querySelectorAll<HTMLElement>('.table-wrapper[role="region"]');
  const syncTabStops = () => {
    wrappers.forEach((w) => {
      if (w.scrollWidth > w.clientWidth + 1) w.setAttribute('tabindex', '0');
      else w.removeAttribute('tabindex');
    });
  };
  syncTabStops();
  window.addEventListener('resize', syncTabStops);
</script>
