---
import { SITE_CONFIG } from '../config/site';
import { t, type Locale } from '../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

// Get translated button labels for client-side JS
const copyLabel = t(lang, 'common.buttons.copy');
const copiedLabel = t(lang, 'common.buttons.copied');
---

<section id="download" class="download-section">
  <div class="container">
    <h2>{t(lang, 'download.title')}</h2>
    <p class="section-subtitle">{t(lang, 'download.subtitle')}</p>

    <div class="install-tabs" lang="en">
      <button class="tab-button active" data-tab="homebrew" aria-pressed="true" aria-controls="panel-homebrew">Homebrew</button>
      <button class="tab-button" data-tab="script" aria-pressed="false" aria-controls="panel-script">Install Script</button>
      <button class="tab-button" data-tab="cargo" aria-pressed="false" aria-controls="panel-cargo">Cargo</button>
    </div>

    <div class="install-panels">
      <div class="install-panel active" id="panel-homebrew">
        <div class="install-command">
          <code>brew install wildcard/caro/caro</code>
          <button class="copy-button" data-command="brew install wildcard/caro/caro" data-copy-label={copyLabel} data-copied-label={copiedLabel}>{copyLabel}</button>
        </div>
        <p class="install-note" lang="en" dir="ltr">Recommended for macOS and Linux with Homebrew</p>
      </div>

      <div class="install-panel" id="panel-script">
        <div class="install-command">
          <code>bash &lt;(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)</code>
          <button class="copy-button" data-command="bash <(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)" data-copy-label={copyLabel} data-copied-label={copiedLabel}>{copyLabel}</button>
        </div>
        <p class="install-note" lang="en" dir="ltr">Auto-detects platform and installs the best option</p>
      </div>

      <div class="install-panel" id="panel-cargo">
        <div class="install-command">
          <code>cargo install caro</code>
          <button class="copy-button" data-command="cargo install caro" data-copy-label={copyLabel} data-copied-label={copiedLabel}>{copyLabel}</button>
        </div>
        <p class="install-note" lang="en" dir="ltr">Requires Rust. Use <code>--features embedded-mlx</code> for Apple Silicon GPU.</p>
      </div>
    </div>

    <p class="binary-intro" lang="en" dir="ltr">Or download pre-built binaries (v{SITE_CONFIG.version}):</p>

    <div class="download-options">
      <a href={`${SITE_CONFIG.downloads.baseUrl}/v${SITE_CONFIG.version}/caro-${SITE_CONFIG.version}-macos-silicon`} class="download-link">macOS (Apple Silicon)</a>
      <a href={`${SITE_CONFIG.downloads.baseUrl}/v${SITE_CONFIG.version}/caro-${SITE_CONFIG.version}-macos-intel`} class="download-link">macOS (Intel)</a>
      <a href={`${SITE_CONFIG.downloads.baseUrl}/v${SITE_CONFIG.version}/caro-${SITE_CONFIG.version}-linux-amd64`} class="download-link">Linux (x86_64)</a>
      <a href={`${SITE_CONFIG.downloads.baseUrl}/v${SITE_CONFIG.version}/caro-${SITE_CONFIG.version}-linux-arm64`} class="download-link">Linux (ARM64)</a>
      <a href={`${SITE_CONFIG.downloads.baseUrl}/v${SITE_CONFIG.version}/caro-${SITE_CONFIG.version}-windows-amd64.exe`} class="download-link">Windows</a>
    </div>

    <div class="usage-modes">
      <h3>{t(lang, 'download.usageModes.title')}</h3>

      <div class="modes-grid">
        <div class="mode-card">
          <h4><span lang="en" dir="ltr"><span class="term-glyph" aria-hidden="true">$</span> Standalone CLI</span></h4>
          <div class="mode-command">
            caro "list files &gt; 100MB"
          </div>
        </div>

        <div class="mode-card">
          <h4><span lang="en" dir="ltr"><span class="term-glyph" aria-hidden="true">❯</span> MCP for Claude</span> <span class="coming-soon">{t(lang, 'download.comingSoonBadge')}</span></h4>
          <p lang="en" dir="ltr">
            Add Caro as an MCP server to Claude Desktop and let her handle all shell commands seamlessly.
          </p>
        </div>

        <div class="mode-card">
          <h4><span lang="en" dir="ltr"><span class="term-glyph" aria-hidden="true">▸</span> Dedicated Skill</span> <span class="available-now">{t(lang, 'common.status.availableNow')}</span></h4>
          <p lang="en" dir="ltr">
            Use Caro as a Skill to offload shell command generation and execution while Claude focuses on your work. Install with <code>/plugin install wildcard/caro</code>
          </p>
        </div>
      </div>

      <div class="quick-start">
        <h3>{t(lang, 'download.quickStart.title')}</h3>
        <div class="quick-start-steps" lang="en" dir="ltr">
          <p>After installing, just use Caro:</p>
          <div class="quick-start-command">
            caro "find all python files modified in the last 7 days"
          </div>
          <p>Caro will generate the command and keep you safe. All installation methods handle prerequisites automatically.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section {
    background: var(--accent-fill);
    color: var(--on-accent);
    text-align: center;
  }

  /* Red band: every text uses --on-accent at full strength. White at 80-90%
     opacity, or on a white tint, drops below 4.5:1 on --accent-fill. */
  .download-section h2 {
    color: var(--on-accent);
  }

  .download-section .section-subtitle {
    color: var(--on-accent);
  }

  .term-glyph {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  /* Commands read left-to-right on RTL pages too. */
  .install-command code,
  .install-note code,
  .mode-command,
  .quick-start-command,
  .mode-card code {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .mode-command,
  .quick-start-command {
    text-align: left;
    overflow-wrap: anywhere;
  }

  .copy-button:focus-visible,
  .tab-button:focus-visible,
  .download-link:focus-visible {
    outline: 3px solid var(--on-accent);
    outline-offset: 2px;
  }

  .install-command {
    background: rgba(0, 0, 0, 0.3);
    padding: 20px 30px;
    border-radius: 8px;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 16px;
    margin: 30px auto;
    max-width: 600px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .install-command code {
    min-width: 0;
    color: var(--on-accent);
    overflow-wrap: anywhere;
  }

  .copy-button {
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--on-accent);
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s;
  }

  .copy-button:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .install-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 30px auto 0;
    max-width: 600px;
  }

  /* Segmented control: outlined white label on the red band; the active
     tab inverts to a white chip with --accent-fill ink (same pair as
     the CTA, reversed). Hover darkens rather than whitening the fill. */
  .tab-button {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: var(--on-accent);
    padding: 10px 24px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s;
  }

  .tab-button:hover {
    background: rgba(0, 0, 0, 0.2);
    color: var(--on-accent);
  }

  .tab-button.active {
    background: var(--on-accent);
    color: var(--accent-fill);
    border-color: var(--on-accent);
  }

  .install-panels {
    margin-top: 20px;
  }

  .install-panel {
    display: none;
  }

  .install-panel.active {
    display: block;
  }

  .install-note {
    font-size: 14px;
    color: var(--on-accent);
    margin-top: 10px;
    text-align: center;
  }

  .install-note code {
    background: rgba(0, 0, 0, 0.3);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.9em;
  }

  .binary-intro {
    margin: 20px 0;
    text-align: center;
  }

  .download-options {
    margin-top: 40px;
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* White chip, --accent-fill ink: 5.0:1 in both modes (--accent-hover
     was 4.2:1 light / 4.0:1 dark). */
  .download-link {
    background: var(--on-accent);
    color: var(--accent-fill);
    padding: 14px 30px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s;
  }

  .download-link:hover {
    color: var(--accent-fill-hover);
    text-decoration: underline;
    transform: translateY(-2px);
  }

  .download-link.disabled {
    background: rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.6);
    cursor: not-allowed;
    opacity: 0.6;
  }

  .download-link.disabled:hover {
    transform: none;
  }

  .coming-soon-inline {
    font-size: 14px;
    background: rgba(255, 255, 255, 0.3);
    padding: 4px 10px;
    border-radius: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .usage-modes {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .usage-modes h3 {
    margin-bottom: 30px;
    font-size: 28px;
  }

  .modes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 30px;
  }

  /* A dark tint keeps white text above 4.5:1; a white tint fell to 4.47:1. */
  .mode-card {
    min-width: 0;
    background: rgba(0, 0, 0, 0.15);
    padding: 25px;
    border-radius: 8px;
  }

  .mode-card h4 {
    margin-bottom: 15px;
    font-size: 20px;
  }

  .mode-card p {
    font-size: 15px;
    line-height: 1.6;
  }

  .mode-command {
    background: rgba(0, 0, 0, 0.3);
    padding: 12px;
    border-radius: 6px;
    margin: 15px 0;
    font-family: monospace;
    font-size: 14px;
    text-align: left;
  }

  .quick-start {
    margin-top: 50px;
    text-align: start;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .quick-start h3 {
    margin-bottom: 20px;
    text-align: center;
  }

  .quick-start-steps {
    font-size: 16px;
    line-height: 1.8;
  }

  .quick-start-steps p {
    margin-bottom: 15px;
  }

  .quick-start-command {
    background: rgba(0, 0, 0, 0.3);
    padding: 15px;
    border-radius: 6px;
    margin: 15px 0;
    font-family: monospace;
  }

  /* Outlined pill (white on the dark-tinted card), and a solid safe-green
     chip with dark ink (5.4:1 light / 9.6:1 dark). */
  .coming-soon {
    display: inline-block;
    font-size: 12px;
    background: transparent;
    border: 1px solid var(--on-accent);
    color: var(--on-accent);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 600;
    margin-inline-start: 8px;
    white-space: nowrap;
  }

  .available-now {
    display: inline-block;
    font-size: 12px;
    background: var(--status-safe);
    color: var(--caro-grey-950);
    padding: 3px 8px;
    border-radius: 12px;
    font-weight: 600;
    margin-inline-start: 8px;
    white-space: nowrap;
  }

  .mode-card code {
    background: rgba(0, 0, 0, 0.3);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.9em;
    color: var(--on-accent);
  }

  /* Tablet breakpoint */
  @media (max-width: 768px) {
    .download-section h2 {
      font-size: 28px;
    }

    .usage-modes h3 {
      font-size: 24px;
    }

    .install-command {
      padding: 16px 20px;
      font-size: 14px;
    }

    .mode-card {
      padding: 20px;
    }

    .mode-card h4 {
      font-size: 18px;
    }
  }

  /* Mobile breakpoint */
  @media (max-width: 600px) {
    .download-section {
      text-align: start;
    }

    .download-section h2,
    .usage-modes h3,
    .quick-start h3 {
      text-align: center;
    }

    .section-subtitle {
      text-align: center;
    }

    .install-tabs {
      flex-wrap: wrap;
      gap: 8px;
    }

    .tab-button {
      padding: 8px 16px;
      font-size: 13px;
      flex: 1;
      min-width: 100px;
    }

    .install-command {
      flex-direction: column;
      gap: 12px;
      text-align: start;
      padding: 16px;
      max-width: 100%;
    }

    .install-command code {
      font-size: 12px;
      word-break: break-all;
      line-height: 1.4;
    }

    .copy-button {
      width: 100%;
      padding: 12px 16px;
      font-size: 15px;
    }

    .download-options {
      flex-direction: column;
      gap: 12px;
      margin-top: 30px;
    }

    .download-link {
      width: 100%;
      text-align: center;
      padding: 14px 20px;
    }

    .modes-grid {
      gap: 16px;
    }

    .mode-card {
      padding: 16px;
    }

    .mode-card h4 {
      font-size: 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .mode-card p {
      font-size: 14px;
    }

    .quick-start {
      max-width: 100%;
      padding: 0;
    }

    .quick-start-steps {
      font-size: 14px;
    }

    .usage-modes {
      margin-top: 40px;
      padding-top: 30px;
    }

    .coming-soon,
    .available-now {
      font-size: 11px;
      padding: 2px 6px;
    }
  }

  /* Small mobile */
  @media (max-width: 360px) {
    .download-section h2 {
      font-size: 24px;
    }

    .install-command code {
      font-size: 11px;
    }

    .mode-card {
      padding: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Copy button functionality
    const copyButtons = document.querySelectorAll('.copy-button');
    copyButtons.forEach(button => {
      button.addEventListener('click', () => {
        const command = button.getAttribute('data-command') || '';
        const copyLabel = button.getAttribute('data-copy-label') || 'Copy';
        const copiedLabel = button.getAttribute('data-copied-label') || 'Copied!';
        navigator.clipboard.writeText(command).then(() => {
          button.textContent = copiedLabel;
          setTimeout(() => {
            button.textContent = copyLabel;
          }, 2000);
        });
      });
    });

    // Tab switching functionality
    const tabButtons = document.querySelectorAll('.tab-button');
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');

        // Update active tab button
        tabButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');

        // Update active panel
        document.querySelectorAll('.install-panel').forEach(panel => {
          panel.classList.remove('active');
        });
        const targetPanel = document.getElementById(`panel-${tabId}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  });
</script>
