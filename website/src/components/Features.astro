---
import { t, type Locale } from '../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

// Feature card definitions with translation keys.
// Emoji are not feature icons: each card uses a sanctioned terminal glyph.
const featureKeys: { key: string; term: string; status: string }[] = [
  { key: 'safetyGuardian', term: '■', status: 'implemented' },
  { key: 'crossPlatform', term: '▸', status: 'implemented' },
  { key: 'platformAware', term: '>_', status: 'implemented' },
  { key: 'posixSpecialist', term: '$', status: 'implemented' },
  { key: 'lightningFast', term: '▸', status: 'in-progress' },
  { key: 'claudeCompanion', term: '❯', status: 'implemented' },
];

// Map status to translation key
const statusLabels: Record<string, string> = {
  'implemented': t(lang, 'common.status.availableNow'),
  'in-progress': t(lang, 'common.status.inDevelopment'),
  'planned': t(lang, 'common.status.planned'),
};
---

<section id="features">
  <div class="container">
    <h2>{t(lang, 'landing.features.title')}</h2>
    <p class="section-subtitle">{t(lang, 'landing.features.subtitle')}</p>
    <p class="alpha-notice"><span aria-hidden="true">🚧</span> <strong>{t(lang, 'landing.features.alphaLabel')}</strong> — {t(lang, 'landing.features.alphaNotice')}</p>
    <div class="features">
      {featureKeys.map((feature) => (
        <div class={`feature feature-${feature.status}`}>
          <div class="feature-header">
            <div class="feature-icon" aria-hidden="true">
              {feature.term}
            </div>
            <span
              class={`status-badge status-${feature.status}`}
              role="status"
              aria-label={`Status: ${statusLabels[feature.status]}`}
            >
              {statusLabels[feature.status]}
            </span>
          </div>
          <h3>{t(lang, `landing.features.cards.${feature.key}.title`)}</h3>
          <p>{t(lang, `landing.features.cards.${feature.key}.description`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .alpha-notice {
    text-align: center;
    margin: 20px auto 0;
    padding: 16px 24px;
    background: rgba(239, 51, 51, 0.1);
    border: 1px solid rgba(239, 51, 51, 0.3);
    border-radius: 8px;
    color: var(--color-text);
    max-width: 700px;
    font-size: 15px;
    line-height: 1.6;
  }

  :global(.dark) .alpha-notice {
    background: rgba(239, 51, 51, 0.15);
    border-color: rgba(239, 51, 51, 0.4);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
    margin-top: 40px;
  }

  .feature {
    min-width: 0;
    text-align: center;
    padding: 30px;
    border-radius: 12px;
    background: var(--color-bg);
    transition: transform 0.2s, box-shadow 0.2s, background 0.3s ease, border-color 0.3s ease;
    border: 1px solid var(--color-border);
  }

  .feature:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(239, 51, 51, 0.1);
    border-color: var(--accent);
  }

  :global(.dark) .feature:hover {
    box-shadow: 0 10px 30px rgba(239, 51, 51, 0.2);
  }

  .feature-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  /* Terminal-glyph / pixel-glyph icon in brand red (decorative). */
  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  .status-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  /* Tinted pills: text tokens pass AA on the blended tint in both modes. */
  .status-implemented {
    background: rgba(63, 163, 77, 0.12);
    color: var(--status-safe-text);
    border: 1px solid rgba(63, 163, 77, 0.4);
  }

  :global(.dark) .status-implemented {
    background: rgba(124, 211, 137, 0.12);
    border-color: rgba(124, 211, 137, 0.4);
  }

  /* In development: highlighter yellow with dark ink (same in both modes). */
  .status-in-progress {
    background: var(--highlight);
    color: var(--caro-grey-950);
    border: 1px solid var(--caro-yellow-500);
  }

  .status-planned {
    background: var(--bg-subtle);
    color: var(--fg-muted);
    border: 1px solid var(--border);
  }

  .feature-planned {
    opacity: 0.85;
  }

  .feature-planned:hover {
    opacity: 1;
  }

  /* Long compound words (de "Plattformübergreifender") must wrap at 375px. */
  .feature h3,
  .feature p {
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .feature h3 {
    font-size: 22px;
    margin-bottom: 12px;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .feature p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    transition: color 0.3s ease;
  }

  @media (max-width: 768px) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
