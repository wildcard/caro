---
/**
 * Icon — modern line icons (Lucide, MIT) with tasteful motion.
 *
 * Interim icon system (per owner direction) while Claude Design designs custom
 * pixel icons. Self-contained: the Lucide SVG path data is inlined here so there
 * is NO runtime/npm dependency (installing lucide-astro perturbed the resolved
 * @astrojs/vercel version and broke the build). Add icons to ICONS as needed
 * from lucide.dev (24x24, stroke, fill=none).
 *
 * Usage:
 *   <Icon name="ShieldCheck" size={20} />          (hover lift — default)
 *   <Icon name="Loader" motion="spin" />           (continuous spin)
 *   <Icon name="Zap" motion="draw" />              (stroke draw-in on load)
 *   <Icon name="Rocket" label="Fast" />            (accessible, non-decorative)
 */
const ICONS: Record<string, string> = {
  Lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  ShieldCheck: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  Shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  Zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  BookOpen: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  Star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  Github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  Rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  Users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  Wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  Search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  Terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  Cpu: '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  Eye: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
  BarChart: '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>',
  HelpCircle: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  FileText: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  Map: '<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>',
  Bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  Ghost: '<path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 21l2.5 1.5L17 19l3 3V10a8 8 0 0 0-8-8z"/>',
  Scale: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  Check: '<path d="M20 6 9 17l-5-5"/>',
  ArrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
  motion?: 'hover' | 'draw' | 'spin' | 'pulse' | 'none';
  strokeWidth?: number;
  label?: string;
}
const {
  name,
  size = 20,
  class: className = '',
  motion = 'hover',
  strokeWidth = 2,
  label,
} = Astro.props;

const inner = ICONS[name as string];
if (!inner) {
  throw new Error(`Icon: unknown icon "${String(name)}". Add its Lucide path to ICONS in Icon.astro.`);
}
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', `icon--${motion}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={inner}
/>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  /* Default: subtle lift + grow on hover (of the icon or its hover-group parent). */
  .icon--hover:hover,
  :where(a, button, .group, [data-icon-hover]):hover > .icon--hover {
    transform: translateY(-1px) scale(1.08);
  }

  /* Stroke draw-in on first paint (great for feature/trust icons). */
  .icon--draw :global(path),
  .icon--draw :global(line),
  .icon--draw :global(polyline),
  .icon--draw :global(polygon),
  .icon--draw :global(circle),
  .icon--draw :global(rect) {
    stroke-dasharray: 72;
    stroke-dashoffset: 72;
    animation: icon-draw 0.7s ease forwards;
  }
  @keyframes icon-draw { to { stroke-dashoffset: 0; } }

  .icon--spin { animation: icon-spin 1.1s linear infinite; }
  @keyframes icon-spin { to { transform: rotate(360deg); } }

  .icon--pulse { animation: icon-pulse 2s ease-in-out infinite; }
  @keyframes icon-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

  @media (prefers-reduced-motion: reduce) {
    .icon, .icon--spin, .icon--pulse { animation: none !important; transition: none !important; }
    .icon--draw :global(*) { stroke-dashoffset: 0 !important; animation: none !important; }
    .icon--hover:hover { transform: none; }
  }
</style>
