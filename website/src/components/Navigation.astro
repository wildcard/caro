---
/**
 * Site navigation for content pages (the homepage uses LPNavigation).
 *
 * - Desktop: menu with disclosure dropdowns (click, Enter/Space, Escape;
 *   hover also opens on pointer devices), GitHub link, search slot,
 *   occasion menu (only while an opt-in holiday is in season), dark mode.
 * - ≤ 900px: a dialog drawer with the same links and appearance controls.
 *
 * Variants:
 * - default: Features, Compare, Resources, Community, Support
 * - use-cases: All Use Cases, By Role, Back to Home
 *
 * Occasion looks live in config/occasions.ts; which holidays are in season
 * comes from lib/holiday-engine.ts (dates + locale rules in holidays.ts).
 */

import { t, type Locale } from '../i18n/config';
import GitHubMark from './icons/GitHubMark.astro';

interface Props {
  variant?: 'default' | 'use-cases';
  currentPage?: string;
  lang?: Locale;
}

const { variant = 'default', currentPage, lang = 'en' } = Astro.props;
const home = lang === 'en' ? '/' : `/${lang}/`;
const repo = 'https://github.com/wildcard/caro';

const personas = [
  { slug: 'sre', title: 'SRE & On-Call Engineers' },
  { slug: 'air-gapped', title: 'Air-Gapped & Security' },
  { slug: 'devops', title: 'DevOps & Platform' },
  { slug: 'tech-lead', title: 'Tech Leads & Managers' },
  { slug: 'developer', title: 'Developers' },
];

const compareLinks = [
  { href: '/compare', title: t(lang, 'common.nav.dropdown.overview'), desc: t(lang, 'common.nav.dropdown.seeAllComparisons') },
  { href: '/compare/warp', title: t(lang, 'common.nav.dropdown.vsWarp'), desc: t(lang, 'common.nav.dropdown.aiNativeTerminal') },
  { href: '/compare/github-copilot-cli', title: t(lang, 'common.nav.dropdown.vsGitHubCopilot'), desc: t(lang, 'common.nav.dropdown.aiPairProgrammer') },
  { href: '/compare/kiro-cli', title: t(lang, 'common.nav.dropdown.vsKiro'), desc: t(lang, 'common.nav.dropdown.awsAssistant') },
];

const resourceLinks = [
  { href: '/use-cases', title: 'Use Cases', desc: 'By role: SRE, DevOps, security' },
  { href: '/blog', title: t(lang, 'common.nav.dropdown.blog'), desc: t(lang, 'common.nav.dropdown.newsAndTutorials') },
  { href: '/docs', title: 'Docs', desc: 'Install, configure, reference' },
  { href: '/explore', title: t(lang, 'common.nav.dropdown.explore'), desc: t(lang, 'common.nav.dropdown.interactiveDemo') },
  { href: '/faq', title: t(lang, 'common.nav.dropdown.faq'), desc: t(lang, 'common.nav.dropdown.commonQuestions') },
  { href: '/roadmap', title: t(lang, 'common.nav.dropdown.roadmap'), desc: t(lang, 'common.nav.dropdown.whatsNext') },
  { href: '/glossary', title: t(lang, 'common.nav.dropdown.glossary'), desc: t(lang, 'common.nav.dropdown.terminalTerms') },
];
---

<nav class="navigation" id="main-nav" aria-label="Main">
  <div class="nav-container">
    <a href={home} class="nav-brand">
      <span class="brand-prompt" aria-hidden="true">&gt;_</span>
      <span class="brand-text">Caro</span>
    </a>

    <div class="nav-desktop">
      {variant === 'use-cases' ? (
        <ul class="nav-menu">
          <li class="nav-item">
            <a href="/use-cases" aria-current={currentPage === 'index' ? 'page' : undefined}>{t(lang, 'common.nav.useCases.allUseCases')}</a>
          </li>
          <li class="nav-item has-dropdown">
            <button class="dropdown-trigger" type="button" aria-expanded="false" aria-controls="dd-roles">
              {t(lang, 'common.nav.useCases.byRole')}
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="dropdown-panel" id="dd-roles">
              {personas.map((p) => (
                <a href={`/use-cases/${p.slug}`} class="dropdown-item" aria-current={currentPage === p.slug ? 'page' : undefined}>
                  <span class="item-title">{p.title}</span>
                </a>
              ))}
            </div>
          </li>
          <li class="nav-item">
            <a href={home}>{t(lang, 'common.nav.useCases.backToHome')}</a>
          </li>
        </ul>
      ) : (
        <ul class="nav-menu">
          <li class="nav-item">
            <a href={`${home}#features`}>{t(lang, 'common.nav.features')}</a>
          </li>
          <li class="nav-item has-dropdown">
            <button class="dropdown-trigger" type="button" aria-expanded="false" aria-controls="dd-compare">
              {t(lang, 'common.nav.compare')}
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="dropdown-panel" id="dd-compare">
              {compareLinks.map((l) => (
                <a href={l.href} class="dropdown-item">
                  <span class="item-title">{l.title}</span>
                  <span class="item-desc">{l.desc}</span>
                </a>
              ))}
            </div>
          </li>
          <li class="nav-item has-dropdown">
            <button class="dropdown-trigger" type="button" aria-expanded="false" aria-controls="dd-resources">
              {t(lang, 'common.nav.resources')}
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="dropdown-panel" id="dd-resources">
              {resourceLinks.map((l) => (
                <a href={l.href} class="dropdown-item">
                  <span class="item-title">{l.title}</span>
                  <span class="item-desc">{l.desc}</span>
                </a>
              ))}
            </div>
          </li>
          <li class="nav-item">
            <a href={`${home}#waitlist`}>Community</a>
          </li>
          <li class="nav-item">
            <a href="/support" class="support-link"><span class="support-heart" aria-hidden="true">♥</span> {t(lang, 'common.nav.support')}</a>
          </li>
        </ul>
      )}

      <div class="nav-actions">
        <div id="nav-search-slot"></div>

        <a href={repo} class="icon-button" target="_blank" rel="noopener noreferrer" aria-label="Caro on GitHub (opens in a new tab)" title="GitHub">
          <GitHubMark size={20} />
        </a>

        <!-- Occasion menu: revealed by script only while an opt-in holiday is in season. -->
        <div class="occasion-menu" data-occasion-menu hidden>
          <button class="icon-button occasion-trigger" type="button" aria-expanded="false" aria-controls="occasion-panel" aria-label={t(lang, 'common.aria.toggleHolidayTheme')} title={t(lang, 'common.nav.appearance.holidayTheme')}>
            <span class="occasion-swatch" aria-hidden="true"></span>
          </button>
          <div class="occasion-panel" id="occasion-panel">
            <p class="panel-header">{t(lang, 'common.nav.appearance.holidayTheme')}</p>
            <div class="occasion-options" data-occasion-options></div>
            <div class="panel-divider"></div>
            <label class="panel-switch" data-snow-row hidden>
              <span>{t(lang, 'common.nav.appearance.snowEffect')}</span>
              <input type="checkbox" class="switch-input" data-snow-toggle />
            </label>
            <label class="panel-switch">
              <span>{t(lang, 'common.nav.appearance.disableEffects')}</span>
              <input type="checkbox" class="switch-input" data-effects-toggle />
            </label>
          </div>
        </div>

        <button id="theme-toggle-desktop" class="icon-button" type="button" aria-label={t(lang, 'common.aria.toggleDarkMode')} title={t(lang, 'common.aria.toggleDarkMode')}>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <a href={`${home}#download`} class="nav-cta">
          {t(lang, 'common.nav.getStarted')}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="nav-compact">
      <a href={repo} class="icon-button" target="_blank" rel="noopener noreferrer" aria-label="Caro on GitHub (opens in a new tab)">
        <GitHubMark size={20} />
      </a>
      <button class="icon-button mobile-toggle" id="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel">
    <div class="drawer-header">
      <a href={home} class="drawer-brand"><span class="brand-prompt" aria-hidden="true">&gt;_</span> Caro</a>
      <div class="drawer-header-actions">
        <div id="nav-search-slot-mobile"></div>
        <button class="icon-button" type="button" id="drawer-close" data-drawer-close aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="drawer-content">
      {variant === 'use-cases' ? (
        <Fragment>
          <div class="drawer-section">
            <a href="/use-cases" class="drawer-link" aria-current={currentPage === 'index' ? 'page' : undefined}>{t(lang, 'common.nav.useCases.allUseCases')}</a>
          </div>
          <div class="drawer-section">
            <p class="section-header">{t(lang, 'common.nav.useCases.byRole')}</p>
            {personas.map((p) => (
              <a href={`/use-cases/${p.slug}`} class="drawer-link" aria-current={currentPage === p.slug ? 'page' : undefined}>{p.title}</a>
            ))}
          </div>
          <div class="drawer-section">
            <a href={home} class="drawer-link">{t(lang, 'common.nav.useCases.backToHome')}</a>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="drawer-section">
            <a href={`${home}#features`} class="drawer-link">{t(lang, 'common.nav.features')}</a>
            <a href={`${home}#video-demo`} class="drawer-link">{t(lang, 'common.buttons.watchDemo')}</a>
          </div>
          <div class="drawer-section">
            <p class="section-header">{t(lang, 'common.nav.compare')}</p>
            {compareLinks.map((l) => <a href={l.href} class="drawer-link">{l.title}</a>)}
          </div>
          <div class="drawer-section">
            <p class="section-header">{t(lang, 'common.nav.resources')}</p>
            {resourceLinks.map((l) => <a href={l.href} class="drawer-link">{l.title}</a>)}
            <a href={repo} class="drawer-link" target="_blank" rel="noopener noreferrer">
              <GitHubMark size={18} />
              <span>{t(lang, 'common.nav.dropdown.github')}</span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </div>
          <div class="drawer-section">
            <a href={`${home}#waitlist`} class="drawer-link">Join the Pack</a>
            <a href="/support" class="drawer-link support-link"><span class="support-heart" aria-hidden="true">♥</span> {t(lang, 'common.nav.mobile.supportCaro')}</a>
          </div>
        </Fragment>
      )}

      <div class="drawer-section theme-section">
        <p class="section-header">{t(lang, 'common.nav.appearance.title')}</p>
        <label class="panel-switch">
          <span>{t(lang, 'common.nav.appearance.darkMode')}</span>
          <input type="checkbox" class="switch-input" id="theme-toggle-mobile" />
        </label>
        <div data-occasion-menu-mobile hidden>
          <label class="panel-row" for="occasion-select-mobile">{t(lang, 'common.nav.appearance.holidayTheme')}</label>
          <select id="occasion-select-mobile" class="theme-select" data-occasion-select></select>
          <label class="panel-switch" data-snow-row hidden>
            <span>{t(lang, 'common.nav.appearance.snowEffect')}</span>
            <input type="checkbox" class="switch-input" data-snow-toggle />
          </label>
          <label class="panel-switch">
            <span>{t(lang, 'common.nav.appearance.disableEffects')}</span>
            <input type="checkbox" class="switch-input" data-effects-toggle />
          </label>
        </div>
      </div>
    </div>

    <div class="drawer-footer">
      <a href={`${home}#download`} class="drawer-cta">{t(lang, 'common.nav.getStarted')}</a>
    </div>
  </div>
</div>

<style>
  .navigation {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-brand,
  .drawer-brand {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg-strong);
    text-decoration: none;
  }

  /* Terminal-glyph mark: sanctioned where the mascot does not fit. */
  .brand-prompt {
    color: var(--accent);
    font-size: 0.8em;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item > a,
  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 12px;
    height: 40px;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    background: none;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }

  .nav-item > a:hover,
  .dropdown-trigger:hover,
  .dropdown-trigger[aria-expanded='true'] {
    color: var(--accent-text);
    background: var(--color-bg-hover);
    text-decoration: none;
  }

  .nav-item > a[aria-current='page'] {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .chevron {
    transition: transform 0.2s;
  }

  .dropdown-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .support-link {
    color: var(--accent-text) !important;
  }

  .support-heart {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .support-link:hover .support-heart {
      animation: heartbeat 1.2s ease-in-out infinite;
    }
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .has-dropdown {
    position: relative;
  }

  .dropdown-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 260px;
    /* Padding (not margin) bridges the gap so hover survives the move. */
    padding-top: 8px;
    display: none;
    z-index: 10;
  }

  .dropdown-panel::before {
    content: '';
    position: absolute;
    inset: 8px 0 0;
    background: var(--bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: -1;
  }

  .dropdown-panel > * {
    margin: 0 8px;
  }

  .dropdown-panel > :first-child {
    margin-top: 8px;
  }

  .dropdown-panel > :last-child {
    margin-bottom: 8px;
  }

  /* Open on click/keyboard (aria-expanded) and on hover for pointers. */
  .dropdown-trigger[aria-expanded='true'] + .dropdown-panel {
    display: block;
  }

  @media (hover: hover) {
    .has-dropdown:hover .dropdown-panel {
      display: block;
    }
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
  }

  .dropdown-item:hover {
    background: var(--color-bg-hover);
    text-decoration: none;
    color: var(--color-text);
  }

  .dropdown-item[aria-current='page'] .item-title {
    color: var(--accent-text);
  }

  .item-title {
    font-weight: 600;
    font-size: 14px;
  }

  .item-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .nav-actions,
  .nav-compact {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-compact {
    display: none;
  }

  #nav-search-slot,
  #nav-search-slot-mobile {
    display: flex;
    align-items: center;
  }

  .icon-button {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .icon-button:hover {
    border-color: var(--fg);
    color: var(--color-text);
  }

  .icon-button svg {
    width: 20px;
    height: 20px;
  }

  #theme-toggle-desktop .icon-sun { display: none; }
  #theme-toggle-desktop .icon-moon { display: block; }
  :global(.dark) #theme-toggle-desktop .icon-sun { display: block; }
  :global(.dark) #theme-toggle-desktop .icon-moon { display: none; }

  /* ---------- occasion menu ---------- */
  .occasion-menu {
    position: relative;
  }

  .occasion-menu[hidden],
  [data-occasion-menu-mobile][hidden] {
    display: none;
  }

  /* Swatch of the active occasion's ribbon; a brand two-tone when none. */
  .occasion-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-text);
    background: var(--occasion-ribbon, linear-gradient(90deg, var(--accent) 0 50%, var(--highlight) 50% 100%));
  }

  .occasion-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 260px;
    background: var(--bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 8px;
    display: none;
    z-index: 10;
  }

  .occasion-trigger[aria-expanded='true'] + .occasion-panel {
    display: block;
  }

  .panel-header {
    margin: 0;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .panel-divider {
    height: 1px;
    background: var(--color-border);
    margin: 6px 0;
  }

  :global(.occasion-option) {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 0 10px;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: 14px;
    text-align: start;
    cursor: pointer;
  }

  :global(.occasion-option:hover) {
    background: var(--color-bg-hover);
  }

  :global(.occasion-option[aria-pressed='true']) {
    font-weight: 700;
  }

  :global(.occasion-option[aria-pressed='true'])::after {
    content: '✓';
    margin-inline-start: auto;
    color: var(--status-safe-text);
  }

  :global(.occasion-dot) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid var(--border-strong);
  }

  .panel-switch,
  .panel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 0 10px;
    font-size: 14px;
    color: var(--color-text);
    cursor: pointer;
  }

  .panel-switch[hidden] {
    display: none;
  }

  /* Native checkbox styled as a switch: keeps keyboard and AT semantics. */
  .switch-input {
    appearance: none;
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 24px;
    margin: 0;
    border-radius: 12px;
    background: var(--caro-grey-500);
    border: 1px solid var(--border-strong);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .switch-input::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--caro-white);
    transition: transform 0.2s;
  }

  .switch-input:checked {
    background: var(--accent-fill);
  }

  .switch-input:checked::before {
    transform: translateX(20px);
  }

  /* ---------- CTA ---------- */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    background: var(--accent-fill);
    color: var(--on-accent);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: background-color 0.2s;
  }

  .nav-cta:hover {
    background: var(--accent-fill-hover);
    color: var(--on-accent);
    text-decoration: none;
  }

  .navigation :is(a, button):focus-visible,
  .mobile-drawer :is(a, button, select, input):focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* ---------- hamburger ---------- */
  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }

  /* ---------- drawer ---------- */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 1100;
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.55);
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(88vw, 380px);
    height: 100%;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xl);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer-panel {
      animation: drawer-in 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  @keyframes drawer-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
  }

  .drawer-section {
    padding: 8px 16px;
  }

  .drawer-section + .drawer-section {
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    margin: 4px 0;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 8px;
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
  }

  .drawer-link:hover,
  .drawer-link[aria-current='page'] {
    background: var(--color-bg-hover);
    color: var(--accent-text);
    text-decoration: none;
  }

  .theme-section {
    background: var(--color-bg-secondary);
    margin: 8px 12px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border) !important;
  }

  .theme-select {
    width: 100%;
    height: 40px;
    padding: 0 10px;
    margin: 0 0 4px;
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font: inherit;
    font-size: 15px;
  }

  .drawer-footer {
    padding: 16px;
    border-top: 1px solid var(--color-border);
  }

  .drawer-cta {
    display: block;
    padding: 14px;
    text-align: center;
    background: var(--accent-fill);
    color: var(--on-accent);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    border-radius: var(--radius-md);
  }

  .drawer-cta:hover {
    background: var(--accent-fill-hover);
    color: var(--on-accent);
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .nav-item > a,
    .dropdown-trigger {
      padding: 0 8px;
    }
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }

    .nav-compact {
      display: flex;
    }
  }
</style>

<script>
  import { holidayEngine } from '../lib/holiday-engine';
  import { getOccasion, occasionIdForSource } from '../config/occasions';
  import { SEASONS } from '../config/seasons';

  const html = document.documentElement;

  // ------------------------------------------------------------ dropdowns
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    '.navigation .dropdown-trigger, .navigation .occasion-trigger',
  );

  function closeAll(except?: HTMLButtonElement) {
    triggers.forEach((t) => {
      if (t !== except) t.setAttribute('aria-expanded', 'false');
    });
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(trigger);
      trigger.setAttribute('aria-expanded', String(!open));
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-dropdown, .occasion-menu')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = Array.from(triggers).find((t) => t.getAttribute('aria-expanded') === 'true');
    if (open) {
      closeAll();
      open.focus();
    }
  });

  // Close a dropdown when keyboard focus leaves it.
  document.querySelectorAll('.navigation .has-dropdown, .navigation .occasion-menu').forEach((wrap) => {
    wrap.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !wrap.contains(next)) {
        wrap.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // --------------------------------------------------------------- drawer
  const drawer = document.getElementById('mobile-drawer');
  const mobileToggle = document.getElementById('mobile-toggle');
  let lastFocus: HTMLElement | null = null;

  function openDrawer() {
    if (!drawer) return;
    lastFocus = document.activeElement as HTMLElement;
    drawer.hidden = false;
    mobileToggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    drawer.querySelector<HTMLElement>('#drawer-close')?.focus();
  }

  function closeDrawer() {
    if (!drawer || drawer.hidden) return;
    drawer.hidden = true;
    mobileToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  mobileToggle?.addEventListener('click', openDrawer);
  drawer?.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', (e) => {
    if (!drawer || drawer.hidden) return;
    if (e.key === 'Escape') closeDrawer();
    if (e.key === 'Tab') {
      // Keep focus inside the open dialog.
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button, select, input, [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null);
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) closeDrawer();
  });

  // ------------------------------------------------------------ dark mode
  const themeToggleDesktop = document.getElementById('theme-toggle-desktop');
  const themeToggleMobile = document.getElementById('theme-toggle-mobile') as HTMLInputElement | null;

  function syncDarkToggles() {
    const isDark = html.classList.contains('dark');
    if (themeToggleMobile) themeToggleMobile.checked = isDark;
    themeToggleDesktop?.setAttribute('aria-pressed', String(isDark));
  }

  function setDark(isDark: boolean) {
    html.classList.toggle('dark', isDark);
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {}
    syncDarkToggles();
  }

  themeToggleDesktop?.addEventListener('click', () => setDark(!html.classList.contains('dark')));
  themeToggleMobile?.addEventListener('change', () => setDark(themeToggleMobile.checked));
  syncDarkToggles();

  // ------------------------------------------------------- occasion menu
  // Opt-in holidays that are in season for this visitor (date + locale).
  const inSeason = Array.from(
    new Set(
      holidayEngine
        .getVisibleThemes()
        .map((h) => occasionIdForSource(h.id))
        .filter((id): id is string => Boolean(id)),
    ),
  );

  const previewing = Boolean(html.dataset.occasionPreview);

  function savedHoliday(): string {
    try {
      return localStorage.getItem('holidayTheme') || 'none';
    } catch {
      return 'none';
    }
  }

  function renderOccasionState(current: string) {
    document.querySelectorAll<HTMLButtonElement>('.occasion-option').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.occasion === current));
    });
    document.querySelectorAll<HTMLSelectElement>('[data-occasion-select]').forEach((s) => {
      s.value = current;
    });
  }

  function applyHoliday(id: string) {
    inSeason.forEach((h) => html.classList.remove(h));
    if (id !== 'none') html.classList.add(id);
    try {
      localStorage.setItem('holidayTheme', id);
    } catch {}
    renderOccasionState(id);
  }

  if (inSeason.length && !previewing) {
    document
      .querySelectorAll<HTMLElement>('[data-occasion-menu], [data-occasion-menu-mobile]')
      .forEach((m) => (m.hidden = false));
    const choices = [...inSeason, 'none'];

    document.querySelectorAll<HTMLElement>('[data-occasion-options]').forEach((box) => {
      box.replaceChildren(
        ...choices.map((id) => {
          const o = getOccasion(id);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'occasion-option';
          btn.dataset.occasion = id;
          const dot = document.createElement('span');
          dot.className = 'occasion-dot';
          dot.setAttribute('aria-hidden', 'true');
          dot.style.background = o ? o.fill : 'transparent';
          btn.append(dot, document.createTextNode(o ? o.name : 'No theme'));
          btn.addEventListener('click', () => applyHoliday(id));
          return btn;
        }),
      );
    });

    document.querySelectorAll<HTMLSelectElement>('[data-occasion-select]').forEach((sel) => {
      sel.replaceChildren(...choices.map((id) => new Option(getOccasion(id)?.name ?? 'No theme', id)));
      sel.addEventListener('change', () => applyHoliday(sel.value));
    });

    const saved = savedHoliday();
    renderOccasionState(choices.includes(saved) ? saved : 'none');

    // Snow is only offered while the winter-snow season is active.
    const winter = SEASONS.find((s) => s.id === 'winter-snow');
    const snowSeason = Boolean(winter && holidayEngine.isSeasonActive(winter));
    document.querySelectorAll<HTMLElement>('[data-snow-row]').forEach((r) => (r.hidden = !snowSeason));

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const snowToggles = document.querySelectorAll<HTMLInputElement>('[data-snow-toggle]');
    const effectsToggles = document.querySelectorAll<HTMLInputElement>('[data-effects-toggle]');
    const effects = window as unknown as {
      snowEffect?: { start(): void; stop(): void };
      newYearEffect?: { stop(): void };
    };

    let snowOn = false;
    let effectsOff = false;
    try {
      const stored = localStorage.getItem('snowEnabled');
      snowOn = snowSeason && !reduceMotion && (stored === null ? true : stored === 'true');
      effectsOff = localStorage.getItem('effectsDisabled') === 'true';
    } catch {}

    const setSnow = (on: boolean) => {
      snowOn = on;
      snowToggles.forEach((t) => (t.checked = on));
      try {
        localStorage.setItem('snowEnabled', String(on));
      } catch {}
      if (on && !effectsOff) effects.snowEffect?.start();
      else effects.snowEffect?.stop();
    };

    const setEffectsOff = (off: boolean) => {
      effectsOff = off;
      effectsToggles.forEach((t) => (t.checked = off));
      try {
        localStorage.setItem('effectsDisabled', String(off));
      } catch {}
      if (off) {
        effects.snowEffect?.stop();
        effects.newYearEffect?.stop();
        document.getElementById('new-year-countdown')?.classList.add('hidden');
      } else if (snowOn) {
        effects.snowEffect?.start();
      }
    };

    snowToggles.forEach((t) => {
      t.checked = snowOn;
      t.addEventListener('change', () => setSnow(t.checked));
    });
    effectsToggles.forEach((t) => {
      t.checked = effectsOff;
      t.addEventListener('change', () => setEffectsOff(t.checked));
    });
    if (snowOn && !effectsOff) setTimeout(() => effects.snowEffect?.start(), 100);
  }
</script>
