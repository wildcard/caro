---
---

<div class="container">
  <div class="terminal">
    <div class="terminal-header" aria-hidden="true">
      <div class="terminal-dot red"></div>
      <div class="terminal-dot yellow"></div>
      <div class="terminal-dot green"></div>
    </div>
    <div class="terminal-line">
      <span class="terminal-prompt">$</span>
      <span class="terminal-command"> caro "find python files modified in the last 7 days"</span>
    </div>
    <div class="terminal-line">
      <span class="terminal-caro">🐕 Caro:</span>
      <span class="terminal-output"> find . -name "*.py" -type f -mtime -7</span>
    </div>
    <div class="terminal-line">
      <span class="terminal-safe">✓ Safe to run on your macOS system</span>
    </div>
  </div>
</div>

<style>
  /* Console surface (grey-700 in both modes). Text uses the console ink
     tokens: --term-fg (beige), --term-prompt / --highlight (yellow accent).
     Red and green cannot reach AA on #4f4f4f, so status colour is carried
     by a rule, not by the text. */
  .terminal {
    background: var(--term-bg);
    border-radius: 8px;
    padding: 20px;
    margin: 40px auto;
    max-width: 700px;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 14px;
    color: var(--term-fg);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    /* A terminal reads left-to-right on RTL pages too. */
    direction: ltr;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .terminal-header {
    display: flex;
    gap: 8px;
    margin-bottom: 15px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: var(--accent); }
  .terminal-dot.yellow { background: var(--highlight); }
  .terminal-dot.green { background: var(--status-safe); }

  .terminal-line {
    margin: 8px 0;
  }

  .terminal-prompt {
    color: var(--term-prompt);
  }

  .terminal-command {
    color: var(--term-fg);
  }

  .terminal-output {
    color: var(--highlight);
  }

  .terminal-caro {
    color: var(--caro-grey-300);
  }

  .terminal-safe {
    display: inline-block;
    color: var(--term-fg);
    border-left: 3px solid var(--status-safe);
    padding-left: 10px;
  }
</style>
