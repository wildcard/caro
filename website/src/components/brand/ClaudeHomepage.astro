    background: var(--caro-yellow-400);
    animation: blink 1s steps(2, end) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .demo-section {
    border-block: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .demo-shell,
  .features {
    padding-block: 96px;
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 44px;
  }

  .section-heading-centered {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading h2 {
