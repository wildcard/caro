    font-size: 13px;
    font-weight: 800;
  }

  .hero-facts dd {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .hero-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 520px;
    place-items: center;
    overflow: hidden;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-lg);
