---
import { t, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

// Get translated button labels for client-side JS
const copyLabel = t(lang, 'common.buttons.copy');
const copiedLabel = t(lang, 'common.buttons.copied');
---

<section id="download" class="download-section">
  <div class="container">
    <img
      class="download-mascot"
      src="/kyaro/happy-bounce.gif"
      alt=""
      width="140"
      height="140"
      loading="lazy"
    />
    <span class="eyebrow">Get Caro</span>
    <h2>Try Caro in 30 Seconds</h2>
    <p class="section-subtitle">No account. No API key. No data collection. Just safer shell commands.</p>

    <div class="install-command">
      <span class="prompt">$</span>
      <code>bash &lt;(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)</code>
      <button class="copy-button" data-command="bash <(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)" data-copy-label={copyLabel} data-copied-label={copiedLabel}>{copyLabel}</button>
    </div>

    <div class="quick-start">
      <p class="then-run">Then run:</p>
      <div class="example-command">
        <code>caro "find files modified in the last 7 days"</code>
      </div>
    </div>

    <div class="trust-points">
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Installs to ~/.cargo/bin</span>
      </div>
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Single binary, no dependencies</span>
      </div>
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Uninstall anytime: cargo uninstall caro</span>
      </div>
    </div>

    <div class="source-note">
      <p>
        Prefer to build from source?
        <a href="https://github.com/wildcard/caro#installation" target="_blank" rel="noopener noreferrer">
          See all installation options →
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .download-section {
    background: var(--caro-grey-900);
    color: var(--fg-inverse);
    text-align: center;
    padding: 80px 20px;
    font-family: var(--font-body);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
  }

  .download-mascot {
    width: 140px;
    height: 140px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    margin: 0 auto 20px;
    display: block;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--caro-yellow-400);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    display: block;
    margin-bottom: 12px;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: var(--track-tight);
    margin-bottom: 14px;
    color: #fff;
  }

  .section-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--caro-grey-300);
    margin-bottom: 40px;
    line-height: 1.55;
  }

  .install-command {
    background: var(--caro-grey-700);
    padding: 16px 22px;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .install-command .prompt {
    color: var(--caro-yellow-400);
    font-weight: 700;
    flex-shrink: 0;
  }

  .install-command code {
    color: #fff;
    text-align: left;
    flex: 1;
    background: transparent;
    padding: 0;
    overflow-x: auto;
  }

  .copy-button {
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #fff;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    transition: background var(--dur-fast) var(--ease);
  }

  .copy-button:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .quick-start {
    margin-top: 26px;
  }

  .then-run {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    color: var(--caro-grey-400);
    text-transform: uppercase;
    letter-spacing: var(--track-wider);
    margin-bottom: 10px;
  }

  .example-command {
    background: var(--caro-grey-800);
    padding: 14px 22px;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg-inverse);
  }

  .trust-points {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--caro-grey-300);
  }

  .check {
    color: var(--caro-yellow-400);
    font-weight: 700;
  }

  .source-note {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid var(--caro-grey-800);
  }

  .source-note p {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--caro-grey-400);
  }

  .source-note a {
    color: var(--caro-beige-100);
    text-decoration: underline;
    font-weight: 600;
    transition: color var(--dur-fast) var(--ease);
  }

  .source-note a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .download-mascot { width: 110px; height: 110px; }
    h2 {
      font-size: 28px;
    }

    .install-command {
      flex-direction: column;
      gap: 14px;
      padding: 18px;
    }

    .install-command code {
      font-size: 12px;
      word-break: break-all;
    }

    .copy-button {
      width: 100%;
    }

    .trust-points {
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-button');
    copyButtons.forEach(button => {
      button.addEventListener('click', () => {
        const command = button.getAttribute('data-command') || '';
        const copyLabel = button.getAttribute('data-copy-label') || 'Copy';
        const copiedLabel = button.getAttribute('data-copied-label') || 'Copied!';
        navigator.clipboard.writeText(command).then(() => {
          button.textContent = copiedLabel;
          setTimeout(() => {
            button.textContent = copyLabel;
          }, 2000);
        });
      });
    });
  });
</script>
