---
import { t, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

// Get translated button labels for client-side JS
const copyLabel = t(lang, 'common.buttons.copy');
const copiedLabel = t(lang, 'common.buttons.copied');
---

<section id="download" class="download-section">
  <div class="container">
    <h2>Try Caro in 30 Seconds</h2>
    <p class="section-subtitle">No account. No API key. No data collection. Just safer shell commands.</p>

    <div class="install-command">
      <code>bash &lt;(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)</code>
      <button class="copy-button" data-command="bash <(curl --proto '=https' --tlsv1.2 -sSfL https://setup.caro.sh)" data-copy-label={copyLabel} data-copied-label={copiedLabel}>{copyLabel}</button>
    </div>

    <div class="quick-start">
      <p class="then-run">Then run:</p>
      <div class="example-command">
        <code>caro "find files modified in the last 7 days"</code>
      </div>
    </div>

    <div class="trust-points">
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Installs to ~/.cargo/bin</span>
      </div>
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Single binary, no dependencies</span>
      </div>
      <div class="trust-point">
        <span class="check">✓</span>
        <span>Uninstall anytime: cargo uninstall caro</span>
      </div>
    </div>

    <div class="source-note">
      <p>
        Prefer to build from source?
        <a href="https://github.com/wildcard/caro#installation" target="_blank" rel="noopener noreferrer">
          See all installation options →
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Section: paper page surface (per Claude Design May 9 ruling — LPDownload
     is a dark stationery card on paper, not a billboard). */
  .download-section {
    background: var(--bg);
    color: var(--fg);
    text-align: center;
    padding: var(--space-3xl) var(--space-md);
  }

  /* Container: the dark stationery card itself. */
  .container {
    max-width: 720px;
    margin: 0 auto;
    background: var(--bg-inverse);
    color: var(--fg-inverse);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-3xl) var(--space-xl);
  }

  h2 {
    font-size: 36px;
    margin-bottom: 12px;
    color: var(--fg-inverse);
  }

  .section-subtitle {
    font-size: 18px;
    color: var(--fg-inverse);
    opacity: 0.8;
    margin-bottom: 40px;
  }

  .install-command {
    background: rgba(0, 0, 0, 0.35);
    padding: 20px 24px;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .install-command code {
    color: var(--fg-inverse);
    text-align: left;
  }

  .copy-button {
    flex-shrink: 0;
    background: var(--accent);
    border: 1px solid var(--accent);
    color: var(--caro-white);
    padding: 8px 20px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .copy-button:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .quick-start {
    margin-top: 30px;
  }

  .then-run {
    font-size: 15px;
    color: var(--fg-inverse);
    opacity: 0.75;
    margin-bottom: 12px;
  }

  .example-command {
    background: rgba(0, 0, 0, 0.25);
    padding: 16px 24px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg-inverse);
  }

  .trust-points {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--fg-inverse);
    opacity: 0.9;
  }

  /* On the flipping --bg-inverse card, --accent (red) dropped to 2.02:1 — the
     same failure class as the historical heading bug. Match the card's text
     system (--fg-inverse, ~12.5:1 both themes); weight 600 keeps the ✓
     distinct from the label. A green-tinted ✓ would need an inverse-polarity
     safe-green token (tracked follow-up), which the standard --status-safe*
     tokens can't provide here. */
  .check {
    color: var(--fg-inverse);
    font-weight: 600;
  }

  .source-note {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .source-note p {
    font-size: 14px;
    color: var(--fg-inverse);
    opacity: 0.75;
  }

  .source-note a {
    color: var(--fg-inverse);
    text-decoration: underline;
    font-weight: 500;
  }

  .source-note a:hover {
    text-decoration: none;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 28px;
    }

    .install-command {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }

    .install-command code {
      font-size: 12px;
      word-break: break-all;
    }

    .copy-button {
      width: 100%;
    }

    .trust-points {
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-button');
    copyButtons.forEach(button => {
      button.addEventListener('click', () => {
        const command = button.getAttribute('data-command') || '';
        const copyLabel = button.getAttribute('data-copy-label') || 'Copy';
        const copiedLabel = button.getAttribute('data-copied-label') || 'Copied!';
        navigator.clipboard.writeText(command).then(() => {
          button.textContent = copiedLabel;
          setTimeout(() => {
            button.textContent = copyLabel;
          }, 2000);
        });
      });
    });
  });
</script>
