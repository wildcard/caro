---
import { type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<footer>
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <img class="brand-mark" src="/mark-caro-smooth.png" alt="" width="40" height="40" loading="lazy" />
        <div class="brand-text">
          <span class="brand-name">Caro</span>
          <span class="brand-tagline">Your loyal shell companion.</span>
        </div>
      </div>
      <div class="footer-links">
        <a href="https://github.com/wildcard/caro">GitHub</a>
        <a href="https://github.com/wildcard/caro/blob/main/LICENSE">AGPL-3.0</a>
        <a href="https://github.com/wildcard/caro/contribute">Contributing</a>
        <a href="https://github.com/wildcard/caro/issues">Report Issue</a>
        <a href="/telemetry">Privacy</a>
        <a href="/support" class="sponsor-link">Support</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="built-with">Built with Rust. <a href="/telemetry" class="footer-privacy-link">Privacy-first.</a></p>
      <p class="mascot-tribute">
        Named after <a href="https://www.instagram.com/kyaroblackheart/" target="_blank" rel="noopener noreferrer">Kyaro</a>, the goodest office dog.
        <a href="/blog/why-caro" class="story-link">Read her story →</a>
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 50px 20px 30px;
    background: var(--caro-grey-900);
    color: var(--fg-inverse);
    font-family: var(--font-body);
    transition: background var(--dur-med) var(--ease), color var(--dur-med) var(--ease);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--caro-grey-800);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    letter-spacing: var(--track-tight);
    color: var(--fg-inverse);
  }

  .brand-tagline {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--caro-grey-400);
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: var(--fg-inverse);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 14px;
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    text-align: center;
  }

  .built-with {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--caro-grey-400);
    margin-bottom: 12px;
  }

  .mascot-tribute {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--caro-grey-400);
  }

  .mascot-tribute a {
    color: var(--fg-inverse);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .mascot-tribute a:hover {
    color: var(--accent);
  }

  .story-link {
    margin-left: 8px;
    color: var(--accent) !important;
    font-weight: 600;
  }

  .sponsor-link::before {
    content: "♥ ";
    color: var(--color-support);
  }

  .sponsor-link:hover {
    color: var(--color-support) !important;
  }

  .footer-privacy-link {
    color: var(--caro-grey-400);
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  .footer-privacy-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      gap: 24px;
      align-items: center;
      text-align: center;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }
  }
</style>
