---
import { t, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<div class="hero">
  <div class="container">
    <img
      class="hero-mascot"
      src="/kyaro/idle.gif"
      alt=""
      width="160"
      height="160"
      loading="eager"
    />
    <div class="hero-badge">{t(lang, 'landing.hero.badge')}</div>
    <h1 class="headline">
      {t(lang, 'landing.hero.headline.line1')}<br />{t(lang, 'landing.hero.headline.line2')} <code class="danger-cmd">{t(lang, 'landing.hero.headline.dangerCmd')}</code>
    </h1>
    <p class="subtitle">
{t(lang, 'landing.hero.subtitle')}
    </p>

    <div class="social-proof">
      <div class="quote">
        {t(lang, 'landing.hero.socialProof.quote')}
      </div>
      <div class="attribution">{t(lang, 'landing.hero.socialProof.attribution')}</div>
    </div>

    <div class="cta-buttons">
      <a href="#download" class="cta-button primary">{t(lang, 'landing.hero.cta.primary')}</a>
      <a href="#scenarios" class="cta-button secondary">{t(lang, 'landing.hero.cta.secondary')}</a>
    </div>

    <div class="trust-badges">
<a href="/telemetry" class="badge badge-link"><span class="icon">🔒</span> {t(lang, 'landing.hero.trustBadges.zeroTelemetry')}</a>
      <span class="badge"><span class="icon">🛡️</span> {t(lang, 'landing.hero.trustBadges.validation')}</span>
      <span class="badge"><span class="icon">⚡</span> {t(lang, 'landing.hero.trustBadges.local')}</span>
      <span class="badge"><span class="icon">📖</span> {t(lang, 'landing.hero.trustBadges.openSource')}</span>
    </div>
  </div>
</div>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 80px 20px 60px;
    background: var(--bg);
    font-family: var(--font-body);
  }

  .container {
    max-width: 900px;
  }

  .hero-mascot {
    width: 160px;
    height: 160px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    margin: 0 auto 24px;
    display: block;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(239, 51, 51, 0.10);
    border: 1px solid rgba(239, 51, 51, 0.35);
    color: var(--accent);
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 30px;
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    font-family: var(--font-body);
  }

  .headline {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: var(--track-tight);
    margin-bottom: 24px;
    color: var(--fg-strong);
  }

  .danger-cmd {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9em;
    background: transparent;
    -webkit-background-clip: initial;
    -webkit-text-fill-color: initial;
    background-clip: initial;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 20px;
    color: var(--fg);
    margin-bottom: 40px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.55;
  }

  .social-proof {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 24px 32px;
    border-radius: 8px;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .quote {
    font-family: var(--font-body);
    font-size: 18px;
    font-style: italic;
    color: var(--fg);
    margin-bottom: 8px;
    line-height: 1.55;
  }

  .attribution {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: var(--track-wider);
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .cta-button {
    display: inline-block;
    padding: 14px 36px;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid transparent;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .cta-button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .cta-button.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    transform: translateY(-1px);
  }

  .cta-button.primary:active {
    background: var(--accent-press);
    border-color: var(--accent-press);
    transform: translateY(0);
  }

  .cta-button.secondary {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--fg-strong);
  }

  .cta-button.secondary:hover {
    background: var(--border-strong);
    color: var(--fg-inverse);
    transform: translateY(-1px);
  }

  :global(.dark) .cta-button.secondary {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  :global(.dark) .cta-button.secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .trust-badges {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--fg-muted);
  }

  .badge .icon {
    font-size: 16px;
  }

  .badge-link {
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .badge-link:hover {
    color: var(--accent);
  }

  .privacy-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .privacy-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .hero-mascot { width: 120px; height: 120px; }
    .headline { font-size: 34px; }
    .subtitle { font-size: 18px; }
    .social-proof { padding: 20px 24px; }
    .quote { font-size: 16px; }
    .cta-buttons { flex-direction: column; align-items: center; }
    .cta-button { width: 100%; max-width: 280px; }
    .trust-badges { flex-direction: column; gap: 12px; }
  }
</style>

<script>
  import { track } from '@vercel/analytics';

  // Track hero CTA clicks
  document.querySelector('.hero .btn-primary')?.addEventListener('click', () => {
    track('cta_click', { location: 'hero', action: 'get_started' });
  });

  document.querySelector('.hero .btn-secondary')?.addEventListener('click', () => {
    track('cta_click', { location: 'hero', action: 'see_demo' });
  });
</script>
