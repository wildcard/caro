---
// LPVideoDemo.astro - Video/GIF demo section
// TODO: Replace placeholder with actual Loom/Kap recording

interface Props {
  videoUrl?: string;
  posterUrl?: string;
}

const { videoUrl, posterUrl } = Astro.props;
const hasVideo = !!videoUrl;
---

<section class="video-demo" id="video-demo">
  <div class="container">
    <div class="section-header">
      <span class="section-label">SEE IT IN ACTION</span>
      <h2 class="section-title">30 Seconds to Terminal Mastery</h2>
      <p class="section-subtitle">
        Watch how Caro transforms natural language into safe POSIX commands
      </p>
    </div>

    <div class="video-container">
      {hasVideo ? (
        <video
          class="demo-video"
          controls
          playsinline
          preload="metadata"
          poster={posterUrl}
        >
          <source src={videoUrl} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      ) : (
        <div class="demo-gif-container">
          <img
            src="/caro-prompting.gif"
            alt="Caro demo - converting natural language to safe shell commands"
            class="demo-gif"
            loading="lazy"
          />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .video-demo {
    padding: 80px 20px;
    background: #0a0a0f;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ff6b35;
    margin-bottom: 16px;
    padding: 8px 16px;
    background: rgba(255, 107, 53, 0.1);
    border-radius: 100px;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: #888;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .video-container {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #1e1e24;
    background: #111116;
  }

  .demo-video {
    width: 100%;
    display: block;
  }

  .demo-gif-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .demo-gif {
    width: 100%;
    display: block;
    border-radius: 12px;
  }

  .demo-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
    padding: 24px;
    background: #0a0a0f;
    border-radius: 12px;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: #16161c;
    border-radius: 8px;
    border: 1px solid #1e1e24;
  }

  .step-number {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff6b35;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .step-text {
    font-size: 0.875rem;
    color: #ccc;
  }

  .step-text code {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.8125rem;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .step-arrow {
    color: #ff6b35;
    font-size: 1.25rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .video-demo {
      padding: 60px 16px;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .video-placeholder {
      padding: 40px 20px;
    }

    .demo-steps {
      flex-direction: column;
      gap: 12px;
    }

    .step-arrow {
      transform: rotate(90deg);
    }

    .step {
      width: 100%;
      justify-content: center;
    }
  }
</style>
