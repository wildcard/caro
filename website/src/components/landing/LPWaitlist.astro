---
// LPWaitlist.astro — Email capture for "Org Visibility for Teams" feature.
// Submissions POST to /api/waitlist (src/pages/api/waitlist.ts) and persist
// to Turso via @astrojs/db. v1 safeguards: server-side email regex + unique
// constraint dedupe + per-IP in-memory rate-limit. Honeypot + time-trap +
// BotID + Upstash sliding-window were removed when this PR (caro-jac.9)
// migrated off Upstash on 2026-05-13. Turnstile + Turso-backed dedupe TTL
// are tracked as v2 follow-ups.
import { t, type Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<section class="waitlist" id="waitlist">
  <div class="container">
    <div class="waitlist-card">
      <div class="waitlist-content">
        <span class="badge">{t(lang, 'waitlist.badge')}</span>
        <h2 class="waitlist-title">{t(lang, 'waitlist.title')}</h2>
        <p class="waitlist-description">{t(lang, 'waitlist.description')}</p>

        <ul class="feature-list">
          <li>
            <span class="check">✓</span>
            <span>{t(lang, 'waitlist.features.analytics')}</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>{t(lang, 'waitlist.features.detection')}</span>
          </li>
          <li>
            <span class="check">✓</span>
            <span>{t(lang, 'waitlist.features.selfHosted')}</span>
          </li>
        </ul>
      </div>

      <div class="waitlist-form-container">
        <form class="waitlist-form" id="waitlist-form">
          <div class="form-group">
            <label for="email" class="sr-only">{t(lang, 'waitlist.form.emailLabel')}</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={t(lang, 'waitlist.form.emailPlaceholder')}
              required
              class="email-input"
            />
          </div>
          <button type="submit" class="submit-button">
            <span class="button-text">{t(lang, 'waitlist.form.cta')}</span>
            <span class="button-icon">→</span>
          </button>
        </form>
        <p class="form-note">{t(lang, 'waitlist.formNote')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Posts to /api/waitlist (Astro server route, src/pages/api/waitlist.ts)
  // backed by Turso via @astrojs/db. Response shape:
  //   { success: boolean, error?: 'already_subscribed'|'invalid_email'|'email_required'|'server_error', count?: number }
  //
  // NOTE(caro-jac.9): Honeypot/time-trap/BotID/upstash-ratelimit safeguards
  // were dropped when this page migrated off Upstash. Server-side rate-limit
  // is a simple per-IP in-memory throttle (see api/waitlist.ts). Turnstile
  // and a Turso-backed dedupe TTL are tracked as v2 follow-ups in caro-jac.9.
  import { track } from '@vercel/analytics';

  const form = document.getElementById('waitlist-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const buttonText = submitButton.querySelector('.button-text') as HTMLSpanElement;

    const email = emailInput.value;

    track('waitlist_signup', { action: 'submit' });

    submitButton.disabled = true;
    buttonText.textContent = 'Joining...';

    let outcome:
      | 'success'
      | 'duplicate'
      | 'invalid'
      | 'rate_limited'
      | 'error' = 'error';

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = (await res.json().catch(() => ({}))) as {
        success?: boolean;
        error?: string;
        count?: number;
      };

      if (res.status === 200 && data.success) {
        outcome = data.error === 'already_subscribed' ? 'duplicate' : 'success';
        buttonText.textContent = data.error === 'already_subscribed'
          ? "You're already on the list ✓"
          : "You're on the list! ✓";
        submitButton.classList.add('success');
        emailInput.value = '';
      } else if (res.status === 429) {
        outcome = 'rate_limited';
        buttonText.textContent = 'Too many tries — slow down';
      } else if (res.status === 400) {
        outcome = 'invalid';
        buttonText.textContent = 'Check your email and try again';
      } else {
        outcome = 'error';
        buttonText.textContent = 'Try again';
      }
    } catch {
      outcome = 'error';
      buttonText.textContent = 'Try again';
    }

    track('waitlist_signup', { action: outcome });

    setTimeout(() => {
      buttonText.textContent = 'Get Early Access';
      submitButton.disabled = false;
      submitButton.classList.remove('success');
    }, 3000);
  });
</script>

<style>
  .waitlist {
    padding: 80px 20px;
    background: var(--caro-grey-950);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .waitlist-card {
    background: var(--caro-grey-800);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 48px;
    box-shadow: var(--shadow-sm);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .waitlist-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .waitlist-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent-fill);
  }

  .badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(239, 51, 51, 0.18);
    padding: 6px 12px;
    border-radius: 100px;
    margin-bottom: 16px;
  }

  .waitlist-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--caro-beige-100);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .waitlist-description {
    font-size: 1rem;
    color: var(--caro-grey-300);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--caro-grey-300);
    line-height: 1.5;
  }

  .check {
    color: #7cd389;
    font-weight: 600;
    flex-shrink: 0;
  }

  .waitlist-form-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }


  .email-input {
    width: 100%;
    padding: 16px 20px;
    font-size: 1rem;
    color: var(--caro-beige-100);
    background: var(--caro-grey-800);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .email-input::placeholder {
    color: var(--fg-muted);
  }

  .email-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(239, 51, 51, 0.15);
  }

  .submit-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 16px 24px;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background: var(--accent-fill);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .submit-button:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--accent-hover);
    box-shadow: var(--shadow-lg);
  }

  .submit-button:disabled {
    opacity: 0.8;
    cursor: not-allowed;
  }

  .submit-button.success {
    background: #15803d;
  }

  .button-icon {
    transition: transform 0.2s ease;
  }

  .submit-button:hover .button-icon {
    transform: translateX(4px);
  }

  .form-note {
    font-size: 0.8125rem;
    color: var(--caro-grey-400, #999);
    text-align: center;
  }

  @media (max-width: 768px) {
    .waitlist {
      padding: 60px 16px;
    }

    .waitlist-card {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 24px;
    }

    .waitlist-title {
      font-size: 1.5rem;
    }
  }
</style>
