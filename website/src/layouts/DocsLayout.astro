---
import '../ui/tokens.css';
import Analytics from '@vercel/analytics/astro';
import GitHubMark from '../components/icons/GitHubMark.astro';
import OccasionHead from '../components/OccasionHead.astro';
import OccasionPreviewBar from '../components/OccasionPreviewBar.astro';
import HumanityEventBanner from '../components/HumanityEventBanner.astro';
import { KavanaCompanion } from '../ui/KavanaCompanion/KavanaCompanion';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Sidebar sections. The current page is marked with aria-current at build
// time; URLs are compared without a trailing slash so /docs/cli/ matches
// the /docs/cli link.
const sections = [
  {
    heading: 'Getting Started',
    links: [
      { href: '/docs', label: 'Overview' },
      { href: '/docs/installation', label: 'Installation' },
      { href: '/docs/quickstart', label: 'Quick Start' },
      { href: '/docs/kavana', label: 'Meet Kavana' },
    ],
  },
  {
    heading: 'Guides',
    links: [
      { href: '/docs/configuration', label: 'Configuration' },
      { href: '/docs/safety', label: 'Safety Levels' },
      { href: '/docs/backends', label: 'Model Backends' },
    ],
  },
  {
    heading: 'Reference',
    links: [
      { href: '/docs/cli', label: 'CLI Reference' },
      { href: '/docs/security', label: 'Security' },
    ],
  },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/caro-pixel.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Caro Docs</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <OccasionHead />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <HumanityEventBanner />
    <nav class="docs-nav" aria-label="Docs">
      <div class="nav-container">
        <a href="/" class="logo">
          <img src="/caro-pixel.png" alt="" width="32" height="32" />
          <span>Caro</span>
        </a>
        <div class="nav-links">
          <a href="/docs">Docs</a>
          <a href="https://github.com/wildcard/caro" class="github-link" target="_blank" rel="noopener noreferrer" aria-label="Caro on GitHub (opens in a new tab)"><GitHubMark size={18} /><span>GitHub</span></a>
        </div>
        <button id="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode">
          <svg class="sun-icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="moon-icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </nav>
    <div class="docs-wrapper">
      <aside class="docs-sidebar">
        <nav class="sidebar-nav" aria-label="Documentation sections">
          {sections.map((section) => (
            <Fragment>
              <h3>{section.heading}</h3>
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </Fragment>
          ))}
        </nav>
      </aside>
      <main id="main-content" class="docs-content" tabindex="-1">
        <article>
          <slot />
        </article>
      </main>
    </div>
    <OccasionPreviewBar />
    <KavanaCompanion client:load />
    <Analytics />
  </body>
</html>

<style is:global>
  /* Alias the tokens.css semantic layer — never re-hardcode the palette. */
  /* --color-bg*, --color-text* and --color-border come from tokens.css. */
  :root {
    --color-accent: var(--accent-text); /* used as text (active links, headings) */
    --color-accent-light: var(--accent-hover);
    --color-code-bg: var(--bg-subtle);
    --color-sidebar-bg: var(--bg-subtle);
  }

  /* Semantic tokens flip via tokens.css; only docs-specific surfaces here. */
  .dark {
    --color-code-bg: var(--caro-grey-800);
    --color-sidebar-bg: var(--caro-grey-950);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Sticky, not fixed: an occasion banner above it pushes it down instead
     of covering it, and it still pins to the top once the banner scrolls away. */
  .docs-nav {
    position: sticky;
    top: 0;
    height: 60px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 18px;
  }

  .logo img {
    border-radius: 4px;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  #theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-secondary);
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  #theme-toggle:hover {
    color: var(--color-text);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  .dark .sun-icon {
    display: block;
  }

  .dark .moon-icon {
    display: none;
  }

  .docs-wrapper {
    display: flex;
    min-height: calc(100vh - 60px);
  }

  .docs-sidebar {
    width: 260px;
    background: var(--color-sidebar-bg);
    border-right: 1px solid var(--color-border);
    padding: 24px 0;
    position: sticky;
    top: 60px;
    flex-shrink: 0;
    align-self: flex-start;
    height: calc(100vh - 60px);
    overflow-y: auto;
  }

  .sidebar-nav {
    padding: 0 20px;
  }

  .sidebar-nav h3 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
    margin: 24px 0 12px;
    font-weight: 600;
  }

  .sidebar-nav h3:first-child {
    margin-top: 0;
  }

  .sidebar-nav ul {
    list-style: none;
  }

  .sidebar-nav li {
    margin: 4px 0;
  }

  .sidebar-nav a {
    display: block;
    padding: 6px 12px;
    color: var(--color-text-tertiary);
    text-decoration: none;
    font-size: 14px;
    border-radius: 6px;
    transition: background-color 0.2s, color 0.2s;
  }

  .sidebar-nav a:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .sidebar-nav a[aria-current='page'] {
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .docs-nav a:focus-visible,
  .sidebar-nav a:focus-visible,
  #theme-toggle:focus-visible,
  .docs-content a:focus-visible,
  .docs-content pre:focus-visible {
    outline: 2px solid var(--fg-strong);
    outline-offset: 2px;
  }

  .docs-content {
    flex: 1;
    min-width: 0;
    max-width: 900px;
    padding: 40px 60px;
  }

  .docs-content h1 {
    font-size: 32px;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .docs-content h2 {
    font-size: 24px;
    margin: 40px 0 16px;
    color: var(--color-text);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  .docs-content h3 {
    font-size: 18px;
    margin: 32px 0 12px;
    color: var(--color-text);
  }

  .docs-content p {
    margin: 16px 0;
    color: var(--color-text-tertiary);
  }

  .docs-content ul, .docs-content ol {
    margin: 16px 0;
    padding-left: 24px;
  }

  .docs-content li {
    margin: 8px 0;
    color: var(--color-text-tertiary);
  }

  .docs-content code {
    background: var(--color-code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
    font-size: 14px;
    overflow-wrap: anywhere; /* long inline flags/paths wrap at 320px */
  }

  .docs-content pre {
    background: var(--color-code-bg);
    padding: 16px 20px;
    border-radius: 8px;
    overflow-x: auto;
    max-width: 100%;
    margin: 20px 0;
  }

  .docs-content pre code {
    background: transparent;
    padding: 0;
  }

  /* In-prose links are underlined so they are not identified by color
     alone (WCAG 1.4.1). */
  .docs-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .docs-content a:hover {
    text-decoration: underline;
  }

  .callout {
    padding: 16px 20px;
    border-radius: 8px;
    margin: 20px 0;
  }

  .callout-warning {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
  }

  .dark .callout-warning {
    background: #3d3520;
    border-left-color: #ffc107;
  }

  .callout-info {
    background: #d1ecf1;
    border-left: 4px solid #17a2b8;
  }

  .dark .callout-info {
    background: #1d3a40;
    border-left-color: #17a2b8;
  }

  .callout-danger {
    background: #f8d7da;
    border-left: 4px solid #dc3545;
  }

  .dark .callout-danger {
    background: #3d2020;
    border-left-color: #dc3545;
  }

  .callout strong {
    display: block;
    margin-bottom: 8px;
  }

  /* Narrow screens: the fixed sidebar becomes a compact, wrapping list of
     links above the article, so every docs page stays one tap away
     (WCAG 1.4.10: no loss of navigation at 320px). */
  @media (max-width: 900px) {
    .docs-wrapper {
      flex-direction: column;
    }

    .docs-sidebar {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding: 12px 0;
    }


    .sidebar-nav h3 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    /* Inline lists let all sections share rows instead of one row each. */
    .sidebar-nav ul {
      display: inline;
    }

    .sidebar-nav li {
      display: inline-block;
      margin: 2px 4px 2px 0;
    }

    .sidebar-nav a {
      padding: 6px 10px;
      font-size: 13px;
    }

    .docs-content {
      margin-left: 0;
      width: 100%;
      max-width: 100%;
      padding: 24px 20px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle');
  const syncToggle = () =>
    themeToggle?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  syncToggle();

  themeToggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {}
    syncToggle();
  });

  // Code blocks that scroll sideways must be reachable by keyboard
  // (WCAG 2.1.1 / axe scrollable-region-focusable). Only blocks that
  // actually overflow get a tab stop; re-check when the viewport changes.
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('.docs-content pre'));
  const syncScrollable = () => {
    blocks.forEach((pre, i) => {
      if (pre.scrollWidth > pre.clientWidth + 1) {
        pre.tabIndex = 0;
        pre.setAttribute('role', 'region');
        pre.setAttribute('aria-label', `Code sample ${i + 1}`);
      } else if (pre.getAttribute('role') === 'region') {
        pre.removeAttribute('tabindex');
        pre.removeAttribute('role');
        pre.removeAttribute('aria-label');
      }
    });
  };
  syncScrollable();
  document.fonts?.ready.then(syncScrollable);
  let resizeFrame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(syncScrollable);
  });
</script>
