---
// LandingPage.astro - Base layout for conversion-focused landing pages
// These pages target specific pain points and personas

import '../ui/tokens.css';
import '../ui/fonts.css';
import OmniSearch from '../components/OmniSearch.astro';
import SearchHighlight from '../components/SearchHighlight.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  persona?: string;
  painPoint?: string;
}

const { title, description, slug, persona, painPoint } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://caro.sh/${slug}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Landing page metadata for internal tracking -->
  <meta name="lp:slug" content={slug} />
  {persona && <meta name="lp:persona" content={persona} />}
  {painPoint && <meta name="lp:pain-point" content={painPoint} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <style is:global>
    /* Landing pages consume the legacy --color-* palette (287 refs across the
       11 LandingPage.astro pages). Rather than rewrite every reference, alias
       those names onto the brand semantic tokens from tokens.css so these pages
       inherit the paper-and-ink identity and auto-follow the light/dark switch.
       `:root:root` (specificity 0,2,0) intentionally beats tokens.css's own
       `:root` / `.dark` legacy --color-* definitions regardless of source order,
       so the deprecated white/slate/orange values never win here. */
    :root:root {
      --color-bg:             var(--bg);
      --color-bg-secondary:   var(--bg-subtle);
      --color-bg-tertiary:    var(--bg-stage);
      --color-text:           var(--fg);
      --color-text-secondary: var(--fg-muted);
      --color-text-tertiary:  var(--fg-strong);
      --color-border:         var(--border);
      /* Links use brand signal-red, not the deprecated orange. */
      --color-link:           var(--accent);
      --color-link-hover:     var(--accent-hover);
      /* Footer is a consistently dark panel (does not invert to paper on dark). */
      --color-footer-bg:         var(--caro-grey-700);
      --color-footer-text:       var(--caro-beige-100);
      --color-footer-text-muted: var(--caro-grey-300);
      --color-links-muted:       var(--caro-grey-300);
    }

    :root:root.dark {
      /* Footer stays dark for separation from the dark page background. */
      --color-footer-bg:         var(--caro-grey-950);
      --color-footer-text:       var(--caro-beige-100);
      --color-footer-text-muted: var(--caro-grey-400);
      --color-links-muted:       var(--caro-grey-500);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-body);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Brand display face (Azeret Mono) for headings. */
    h1, h2, h3, h4 {
      font-family: var(--font-display);
    }

    /* ============================================
       GLOBAL LINK STYLES
       Uses CSS variables for theme support
       ============================================ */
    a {
      color: var(--color-link);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    a:focus-visible {
      outline: 2px solid var(--color-link);
      outline-offset: 2px;
      border-radius: 2px;
    }

    section {
      padding: 80px 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    h2 {
      font-size: 36px;
      text-align: center;
      margin-bottom: 16px;
      color: var(--color-text);
    }

    .section-subtitle {
      text-align: center;
      color: var(--color-text-secondary);
      font-size: 18px;
      margin-bottom: 40px;
    }
  </style>
</head>
<body>
  <OmniSearch />
  <slot />
  <SearchHighlight />

  <!-- Theme initialization (prevent flash) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</body>
</html>
