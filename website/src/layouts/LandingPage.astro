---
// LandingPage.astro - Base layout for conversion-focused landing pages
// These pages target specific pain points and personas

import '../ui/tokens.css';
import OmniSearch from '../components/OmniSearch.astro';
import OccasionHead from '../components/OccasionHead.astro';
import OccasionPreviewBar from '../components/OccasionPreviewBar.astro';
import HumanityEventBanner from '../components/HumanityEventBanner.astro';
import SearchHighlight from '../components/SearchHighlight.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  persona?: string;
  painPoint?: string;
}

const { title, description, slug, persona, painPoint } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://caro.sh/${slug}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Landing page metadata for internal tracking -->
  <meta name="lp:slug" content={slug} />
  {persona && <meta name="lp:persona" content={persona} />}
  {painPoint && <meta name="lp:pain-point" content={painPoint} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <style is:global>
    /* Alias the tokens.css semantic layer — never re-hardcode the palette. */
    :root {
      --color-bg: var(--bg);
      --color-bg-secondary: var(--bg-subtle);
      --color-bg-tertiary: var(--bg-raised);
      --color-text: var(--fg);
      --color-text-secondary: var(--fg-muted);
      --color-text-tertiary: var(--fg-strong);
      --color-border: var(--border);
      --color-footer-bg: var(--bg-inverse);
      --color-footer-text: var(--fg-inverse);
      --color-footer-text-muted: var(--caro-grey-300);
      --color-links-muted: var(--fg-muted);
      /* Link colors come from tokens.css (--accent-text family). */
    }

    /* Semantic tokens flip via tokens.css; only the footer differs. */
    .dark {
      --color-footer-bg: var(--caro-grey-950);
      --color-footer-text: var(--caro-beige-100);
      --color-footer-text-muted: var(--caro-grey-300);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-body);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* ============================================
       GLOBAL LINK STYLES
       Uses CSS variables for theme support
       ============================================ */
    a {
      color: var(--color-link);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    a:focus-visible {
      outline: 2px solid var(--color-link);
      outline-offset: 2px;
      border-radius: 2px;
    }

    section {
      padding: 80px 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    h2 {
      font-size: 36px;
      text-align: center;
      margin-bottom: 16px;
      color: var(--color-text);
    }

    .section-subtitle {
      text-align: center;
      color: var(--color-text-secondary);
      font-size: 18px;
      margin-bottom: 40px;
    }
  </style>
  <!-- Theme initialization in <head> so dark-mode visitors see no light flash. -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <OccasionHead />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HumanityEventBanner />
  <OmniSearch />
  <slot />
  <SearchHighlight />
  <OccasionPreviewBar />
</body>
</html>
