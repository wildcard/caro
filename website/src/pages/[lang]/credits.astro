---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { languages, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== 'en')  // English stays at /credits
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<Layout
  title="Credits & Attribution - Caro"
  description="Caro stands on the shoulders of giants. This page honors the open source projects, maintainers, and communities that make Caro possible."
  lang={lang}
>
  <Navigation lang={lang} />

  <main id="main-content" class="credits-page">
    <!-- Opening Crawl / Hero -->
    <section class="credits-hero">
      <div class="stars"></div>
      <div class="twinkling"></div>
      <div class="container">
        <div class="crawl-text">
          <p class="episode">A LONG TIME AGO IN AN OPEN SOURCE ECOSYSTEM FAR, FAR AWAY...</p>
          <h1>CREDITS</h1>
          <p class="tagline">Standing on the Shoulders of Giants</p>
        </div>
        <p class="intro">
          Caro is an open source project that would not exist without the incredible work of countless developers,
          maintainers, and communities who have built the foundations we rely on every day. This page is our way
          of saying <strong>thank you</strong> to everyone who has contributed to the tools, libraries, and
          resources that make Caro possible.
        </p>
      </div>
    </section>

    <!-- Note: Full credits content would be imported from the main credits.astro -->
    <!-- For now, this is a placeholder structure that can be expanded -->
    <div class="credits-content">
      <section class="credits-section">
        <div class="container">
          <p>Credits content will be localized in future iterations.</p>
          <p><a href="/credits">View English credits page →</a></p>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .credits-page {
    background: var(--color-bg);
    min-height: 100vh;
  }

  .credits-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px;
    overflow: hidden;
    background: var(--bg-inverse);
  }

  .stars, .twinkling {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Same star field as the English /credits page (the old /stars.png and
     /twinkling.png assets do not exist). */
  .stars {
    background: transparent url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><circle fill="%23FFF" cx="50" cy="50" r="1"/><circle fill="%23FFF" cx="100" cy="30" r="0.5"/><circle fill="%23FFF" cx="150" cy="80" r="1"/><circle fill="%23FFF" cx="30" cy="120" r="0.5"/><circle fill="%23FFF" cx="170" cy="150" r="1"/><circle fill="%23FFF" cx="80" cy="180" r="0.5"/></svg>') repeat;
    background-size: 200px 200px;
    z-index: 0;
    animation: twinkle 5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars { animation: none; }
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
  }

  .crawl-text {
    margin-bottom: 40px;
  }

  .episode {
    color: #ffd700;
    font-size: 14px;
    letter-spacing: 4px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 72px;
    font-weight: 700;
    color: #ffd700;
    margin-bottom: 10px;
  }

  .tagline {
    font-size: 24px;
    color: #fff;
    font-style: italic;
  }

  .intro {
    font-size: 18px;
    line-height: 1.8;
    color: #e0e0e0;
  }

  .intro strong {
    color: var(--highlight);
  }

  .credits-content {
    padding: 60px 20px;
  }

  .credits-section {
    margin-bottom: 60px;
  }

  .credits-section a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .credits-section a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    h1 { font-size: 48px; }
    .tagline { font-size: 18px; }
    .intro { font-size: 16px; }
  }
</style>
