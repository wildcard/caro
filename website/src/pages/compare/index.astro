---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import TermGlyph from '../../ui/TermGlyph/TermGlyph.astro';
import type { Glyph } from '../../ui/TermGlyph/TermGlyph.astro';
import { vsPages, lastVerified } from '../../data/compare-pages';

const lang = 'en';

// Detailed comparison matrix. 'partial' means opt-in, configurable or
// incomplete; 'unknown' means the vendor's docs do not say (never turn a
// missing source into false). The per-tool pages explain each cell. Cells
// not changed in the 2026-10-11 refresh are carried over unverified; see
// docs/research/2026-10-11-competitive-landscape-refresh.md section 6.
// Criteria: "Uses your existing terminal" = the product's AI is usable from
// the user's own terminal emulator; "Model-agnostic" = the user can choose
// among providers or a custom endpoint.
const comparisonMatrix = {
  categories: [
    {
      name: 'Privacy & Data Control',
      icon: '▸',
      description: 'How your terminal activity is handled',
      features: [
        { name: 'Works offline (Caro: default backend, after one model download)', caro: true, copilot: 'partial', warp: false, kiro: false, opencode: 'partial' },
        { name: 'Privacy-first defaults', caro: true, copilot: 'partial', warp: false, kiro: false, opencode: true },
        { name: 'Commands never leave your machine', caro: true, copilot: 'partial', warp: false, kiro: false, opencode: 'partial' },
        { name: 'Air-gapped environment support', caro: true, copilot: 'partial', warp: false, kiro: false, opencode: 'partial' },
        { name: 'Full source code available', caro: true, copilot: false, warp: 'partial', kiro: false, opencode: true },
      ]
    },
    {
      name: 'Safety & Guardrails',
      icon: '■',
      description: 'What happens before a command runs',
      features: [
        { name: 'Built-in dangerous-command patterns', caro: true, copilot: 'unknown', warp: 'partial', kiro: 'unknown', opencode: false },
        // "Blocks ... by default": false where the vendor documents the default as
        // asking, not blocking (Copilot, Kiro, Warp) or allowing (OpenCode bash).
        { name: 'Blocks rm -rf /, fork bombs by default', caro: true, copilot: false, warp: false, kiro: false, opencode: false },
        { name: 'Asks before running commands, by default', caro: true, copilot: 'partial', warp: 'partial', kiro: 'partial', opencode: false },
        { name: 'Risk level for each command', caro: true, copilot: 'unknown', warp: 'unknown', kiro: 'unknown', opencode: false },
        { name: 'Custom command rules (patterns, allow/deny lists)', caro: true, copilot: true, warp: true, kiro: true, opencode: true },
      ]
    },
    {
      name: 'Shell Expertise',
      icon: '>_',
      description: 'Specialized for terminal workflows',
      features: [
        { name: 'POSIX-first command generation', caro: true, copilot: 'partial', warp: 'partial', kiro: 'partial', opencode: 'partial' },
        { name: 'GNU vs BSD syntax awareness', caro: true, copilot: 'partial', warp: 'unknown', kiro: 'partial', opencode: 'partial' },
        { name: 'Uses your existing terminal', caro: true, copilot: true, warp: true, kiro: true, opencode: true },
        { name: 'macOS, Linux and Windows', caro: true, copilot: true, warp: true, kiro: true, opencode: true },
        { name: 'Shell-specific optimizations', caro: true, copilot: 'partial', warp: 'partial', kiro: 'partial', opencode: 'partial' },
      ]
    },
    {
      name: 'Architecture & Extensibility',
      icon: '❯',
      description: 'Technical foundation and flexibility',
      features: [
        { name: 'Local model inference', caro: true, copilot: 'partial', warp: 'partial', kiro: false, opencode: 'partial' },
        { name: 'Local backends (MLX, Ollama, vLLM)', caro: true, copilot: 'partial', warp: 'partial', kiro: false, opencode: 'partial' },
        { name: 'No account required', caro: true, copilot: 'partial', warp: false, kiro: false, opencode: true },
        { name: 'Model-agnostic design', caro: true, copilot: true, warp: true, kiro: 'partial', opencode: true },
        { name: 'Apple Silicon optimized (MLX)', caro: 'partial', copilot: false, warp: false, kiro: false, opencode: false },
      ]
    },
  ]
};

function renderValue(value: boolean | string) {
  if (value === true) return { icon: '✓', class: 'yes', label: 'Yes' };
  if (value === false) return { icon: '✗', class: 'no', label: 'No' };
  if (value === 'partial') return { icon: '◐', class: 'partial', label: 'Partial' };
  if (value === 'planned') return { icon: '◎', class: 'planned', label: 'Planned' };
  if (value === 'unknown') return { icon: '?', class: 'partial', label: 'Not documented' };
  return { icon: value, class: 'text', label: value };
}
---

<Layout
  title="Compare Caro - Shell AI Comparison | Caro vs Copilot, Warp, Kiro CLI"
  description="See how Caro compares to GitHub Copilot CLI, Warp, Kiro CLI, and other shell AI tools. Local-first, safety-focused, privacy-first."
  lang={lang}
>
  <Navigation />

  <main id="main-content" class="compare-page">
    <section class="hero">
      <div class="container">
        <h1>Compare Caro to Alternatives</h1>
        <p class="hero-subtitle">
          Make an informed decision. See how Caro's local-first, safety-focused approach
          compares to other AI shell and coding tools.
        </p>

        <!-- Trust Badges -->
        <div class="trust-badges">
          <a href="/telemetry" class="badge badge-link"><span class="badge-icon"><TermGlyph g="▸" /></span> Privacy-First*</a>
          <span class="badge"><span class="badge-icon"><TermGlyph g="■" /></span> 52+ Safety Patterns</span>
          <span class="badge"><span class="badge-icon"><TermGlyph g="$" /></span> Offline by Default</span>
          <span class="badge"><span class="badge-icon"><TermGlyph g="❯" /></span> Open Source</span>
        </div>
      </div>
    </section>

    <!-- Quick Compare Cards -->
    <section class="vs-cards-section">
      <div class="container">
        <h2>Choose a Comparison</h2>
        <p class="section-subtitle">Deep-dive into how Caro stacks up against specific tools</p>

        <div class="vs-cards">
          {vsPages.map((page) => (
            <a href={`/compare/${page.slug}`} class="vs-card">
              <div class="vs-card-header">
                <span class="vs-icon">{page.icon}</span>
                <span class="vs-label">vs</span>
              </div>
              <h3>{page.name}</h3>
              <p class="vs-tagline">{page.tagline}</p>
              <p class="vs-description">{page.description}</p>
              <div class="vs-cta">
                <span class="key-diff">{page.keyDiff}</span>
                <span class="arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Full Comparison Matrix -->
    <section class="matrix-section">
      <div class="container">
        <h2>Complete Feature Comparison</h2>
        <p class="section-subtitle">
          Every feature, every tool. Make your own decision.
        </p>

        {comparisonMatrix.categories.map((category) => (
          <div class="matrix-category">
            <h3 class="category-header">
              <span class="category-icon"><TermGlyph g={category.icon as Glyph} /></span>
              {category.name}
              <span class="category-desc">{category.description}</span>
            </h3>

            <div class="table-wrapper" tabindex="0" role="region" aria-label={`${category.name} comparison table`}>
              <table class="matrix-table">
                <thead>
                  <tr>
                    <th class="feature-col">Feature</th>
                    <th class="tool-col highlight">Caro</th>
                    <th class="tool-col">Copilot CLI</th>
                    <th class="tool-col">Warp</th>
                    <th class="tool-col">Kiro CLI</th>
                    <th class="tool-col">OpenCode</th>
                  </tr>
                </thead>
                <tbody>
                  {category.features.map((feature) => (
                    <tr>
                      <td class="feature-name">{feature.name}</td>
                      <td class={`value ${renderValue(feature.caro).class} highlight-col`}>
                        <span class="value-icon" aria-hidden="true">{renderValue(feature.caro).icon}</span>
                        <span class="visually-hidden">{renderValue(feature.caro).label}</span>
                      </td>
                      <td class={`value ${renderValue(feature.copilot).class}`}>
                        <span class="value-icon" aria-hidden="true">{renderValue(feature.copilot).icon}</span>
                        <span class="visually-hidden">{renderValue(feature.copilot).label}</span>
                      </td>
                      <td class={`value ${renderValue(feature.warp).class}`}>
                        <span class="value-icon" aria-hidden="true">{renderValue(feature.warp).icon}</span>
                        <span class="visually-hidden">{renderValue(feature.warp).label}</span>
                      </td>
                      <td class={`value ${renderValue(feature.kiro).class}`}>
                        <span class="value-icon" aria-hidden="true">{renderValue(feature.kiro).icon}</span>
                        <span class="visually-hidden">{renderValue(feature.kiro).label}</span>
                      </td>
                      <td class={`value ${renderValue(feature.opencode).class}`}>
                        <span class="value-icon" aria-hidden="true">{renderValue(feature.opencode).icon}</span>
                        <span class="visually-hidden">{renderValue(feature.opencode).label}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}

        <!-- Legend -->
        <div class="legend">
          <span class="legend-item"><span class="legend-icon yes" aria-hidden="true">✓</span> Full support</span>
          <span class="legend-item"><span class="legend-icon partial" aria-hidden="true">◐</span> Partial, opt-in or configurable</span>
          <span class="legend-item"><span class="legend-icon no" aria-hidden="true">✗</span> Not supported</span>
          <span class="legend-item"><span class="legend-icon planned" aria-hidden="true">◎</span> Planned</span>
          <span class="legend-item"><span class="legend-icon partial" aria-hidden="true">?</span> Not documented by the vendor</span>
        </div>
        <p class="verified-note">
          Competitor claims updated on <time datetime={lastVerified}>{lastVerified}</time> were checked against each vendor's docs;
          sources are on each comparison page. Other cells are older and not re-verified. Something out of date?
          <a href="https://github.com/wildcard/caro/issues/new">Tell us</a>.
        </p>
      </div>
    </section>

    <!-- Why Caro Section -->
    <section class="why-section">
      <div class="container">
        <h2>Why Teams Choose Caro</h2>

        <div class="reasons">
          <div class="reason">
            <h3><TermGlyph g="▸" /> For Security-Conscious Orgs</h3>
            <p>Air-gapped environments, compliance requirements, or simply not wanting shell commands to leave your network? With its default embedded backend, Caro runs locally after a one-time model download, with <a href="/telemetry" class="inline-link">privacy-first design</a>.</p>
          </div>

          <div class="reason">
            <h3><TermGlyph g="■" /> For SREs Who Can't Afford Mistakes</h3>
            <p>Rule-based safety checks catch dangerous commands before they execute. 52+ patterns block rm -rf /, fork bombs, and other destructive operations.</p>
          </div>

          <div class="reason">
            <h3><TermGlyph g=">_" /> For DevOps Who Live in the Terminal</h3>
            <p>Works in YOUR terminal. No new apps, no context switching. Just shell commands that work across macOS, Linux, and BSD with POSIX compliance.</p>
          </div>

          <div class="reason">
            <h3><TermGlyph g="$" /> For Developers Who Work Offline</h3>
            <p>Airplanes, VPNs, restricted networks. When you can't phone home, Caro still works with local model inference.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="final-cta">
      <div class="container">
        <h2>Ready to Try Caro?</h2>
        <p>Join developers who refuse to sacrifice privacy for productivity.</p>
        <div class="cta-buttons">
          <a href="/#download" class="cta-button primary">Get Started Free</a>
          <a href="https://github.com/wildcard/caro" class="cta-button secondary" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        </div>
        <p class="cta-note">Open source. No account required. <a href="/telemetry" class="cta-note-link">Privacy-first.</a></p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .compare-page {
    background: var(--color-bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Hero */
  .hero {
    padding: 80px 20px 60px;
    text-align: center;
    background: var(--bg);
  }

  .hero h1 {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 18px;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 30px;
    line-height: 1.6;
  }

  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }

  .badge-icon {
    font-size: 16px;
  }

  /* VS Cards Section */
  .vs-cards-section {
    padding: 60px 20px;
  }

  .vs-cards-section h2 {
    font-size: 32px;
    text-align: center;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    margin-bottom: 40px;
  }

  .vs-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 24px;
  }

  .vs-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 28px;
    text-decoration: none;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
  }

  .vs-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(239, 51, 51, 0.15);
  }

  .vs-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .vs-icon {
    font-size: 32px;
  }

  .vs-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .vs-card h3 {
    font-size: 20px;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .vs-tagline {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 12px;
  }

  .vs-description {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex-grow: 1;
  }

  .vs-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .key-diff {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    padding: 6px 12px;
    border-radius: 100px;
  }

  .arrow {
    font-size: 20px;
    color: var(--accent-text);
    transition: transform 0.2s;
  }

  .vs-card:hover .arrow {
    transform: translateX(4px);
  }

  /* Matrix Section */
  .matrix-section {
    padding: 60px 20px;
    background: var(--color-bg-secondary);
  }

  .matrix-section h2 {
    font-size: 32px;
    text-align: center;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .matrix-category {
    margin-bottom: 40px;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    margin-bottom: 16px;
    color: var(--color-text);
    flex-wrap: wrap;
  }

  .category-icon {
    font-size: 24px;
  }

  .category-desc {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-left: auto;
  }

  /* position: relative contains the visually-hidden cell labels, which would
     otherwise escape the scroller and widen the page at 375px. */
  .table-wrapper {
    position: relative;
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .table-wrapper:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  .matrix-table th,
  .matrix-table td {
    padding: 14px 16px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .matrix-table th {
    background: var(--color-bg-tertiary);
    font-weight: 600;
    font-size: 13px;
    color: var(--color-text);
  }

  /* 8% tint keeps --accent-text above 4.5:1 on the blended header cell. */
  .matrix-table th.highlight {
    background: rgba(239, 51, 51, 0.08);
    color: var(--accent-text);
  }

  .feature-col {
    text-align: left !important;
    min-width: 280px;
  }

  .tool-col {
    min-width: 100px;
    white-space: nowrap;
  }

  .feature-name {
    text-align: left !important;
    font-size: 14px;
    color: var(--color-text);
  }

  .matrix-table tbody tr:last-child td {
    border-bottom: none;
  }

  .matrix-table tbody tr:hover {
    background: var(--color-bg-tertiary);
  }

  .value {
    font-size: 18px;
  }

  .highlight-col {
    background: rgba(239, 51, 51, 0.05);
  }

  .value-icon {
    font-weight: 600;
  }

  /* Status glyphs must clear 3:1 (non-text) in both modes. */
  .value.yes .value-icon { color: var(--status-safe-text); }
  .value.no .value-icon { color: var(--accent-text); }
  .value.partial .value-icon { color: var(--fg-muted); }
  .value.planned .value-icon { color: #8b5cf6; }

  .legend {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 30px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-icon {
    font-weight: 600;
  }

  .verified-note {
    margin-top: 16px;
    text-align: center;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .verified-note a {
    color: inherit;
    text-decoration: underline;
  }

  .legend-icon.yes { color: var(--status-safe-text); }
  .legend-icon.no { color: var(--accent-text); }
  .legend-icon.partial { color: var(--fg-muted); }
  .legend-icon.planned { color: #8b5cf6; }

  /* Why Section */
  .why-section {
    padding: 80px 20px;
  }

  .why-section h2 {
    font-size: 32px;
    text-align: center;
    margin-bottom: 40px;
    color: var(--color-text);
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 30px;
  }

  .reason {
    padding: 24px;
    background: var(--color-bg-secondary);
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .reason h3 {
    font-size: 18px;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .reason p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* Final CTA */
  .final-cta {
    padding: 80px 20px;
    text-align: center;
    background: var(--accent-fill);
    color: var(--on-accent);
  }

  .final-cta h2 {
    font-size: 36px;
    margin-bottom: 16px;
    color: white;
  }

  /* No opacity on the copy: faded white drops below 4.5:1 on --accent-fill. */
  .final-cta p {
    font-size: 18px;
    margin-bottom: 30px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.2s;
  }

  /* White button on the red band: --caro-red-700 is 6:1 on white in both
     modes (--accent-hover / --accent-text are too light for white). */
  .cta-button.primary {
    background: white;
    color: var(--caro-red-700);
  }

  .cta-button.primary:hover {
    color: var(--caro-red-700);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .cta-button.secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
  }

  .cta-button.secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  /* A red focus ring is invisible on the red band; use white. */
  .final-cta a:focus-visible {
    outline: 3px solid white;
    outline-offset: 3px;
  }

  .cta-note {
    font-size: 14px;
  }

  .cta-note-link {
    color: white;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .cta-note-link:hover {
    color: white;
    text-decoration-style: solid;
  }

  .badge-link {
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .badge-link:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .inline-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  .inline-link:hover {
    color: var(--accent-text);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 32px;
    }

    .vs-cards-section h2,
    .matrix-section h2,
    .why-section h2 {
      font-size: 26px;
    }

    .category-desc {
      display: block;
      flex-basis: calc(100% - 36px);
      margin-left: 36px;
      margin-top: 8px;
    }

    .final-cta h2 {
      font-size: 28px;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-button {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
